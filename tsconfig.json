{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    // oxlint (no-unused-vars) is the single authority on unused symbols so the
    // preserved scenes.ts (with its dormant scene sources, re-enabled in the
    // generative mode) stays byte-untouched. tsc keeps every other strict check.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
