#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/data/nuxt-blue-red-and-purple/node_modules/.pnpm/@nuxt+telemetry@2.8.0_@nuxt+kit@3.21.11_magicast@0.5.4_/node_modules/@nuxt/telemetry/node_modules:/data/nuxt-blue-red-and-purple/node_modules/.pnpm/@nuxt+telemetry@2.8.0_@nuxt+kit@3.21.11_magicast@0.5.4_/node_modules:/data/nuxt-blue-red-and-purple/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/data/nuxt-blue-red-and-purple/node_modules/.pnpm/@nuxt+telemetry@2.8.0_@nuxt+kit@3.21.11_magicast@0.5.4_/node_modules/@nuxt/telemetry/node_modules:/data/nuxt-blue-red-and-purple/node_modules/.pnpm/@nuxt+telemetry@2.8.0_@nuxt+kit@3.21.11_magicast@0.5.4_/node_modules:/data/nuxt-blue-red-and-purple/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../bin/nuxt-telemetry.mjs" "$@"
else
  exec node  "$basedir/../../bin/nuxt-telemetry.mjs" "$@"
fi
