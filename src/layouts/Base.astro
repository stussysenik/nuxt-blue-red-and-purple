---
// Reset ships via the vendored Tachyons preflight (uno.config.ts) — no extra
// reset import, so nothing fights the kernel. Fonts + base tokens + the four
// mode kernels are the design truth loaded globally.
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/modes/essential.css';
import '../styles/modes/brutal.css';
import '../styles/modes/clay.css';
import '../styles/modes/generative.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = '*blue red + purple/',
  description = 'A design agency with one specialization: one-page systems. One fixed content structure, four interchangeable design systems — switched live.',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="essential">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- theme-color follows the paper core, never a forbidden hue (color law) -->
    <meta name="theme-color" content="#F7F3EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16130F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/archivo-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content="blue red + purple" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blueredandpurple.world/" />
    <meta property="og:image" content="https://blueredandpurple.world/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- No-FOUC bootstrap: resolve theme before first paint (mode default = essential). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

  </head>
  <body>
    <slot />

    <!-- Lenis smooth scroll; native fallback under reduced-motion. GSAP
         ScrollTrigger is wired onto this ticker in Milestone 5. -->
    <script>
      import Lenis from 'lenis';

      const root = document.documentElement;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lenis = reduced ? null : new Lenis({ smoothWheel: true });

      if (lenis) {
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }

      // Lock page scroll while an overlay (index or work) is open. The store owns
      // the truth and projects it to data-overlay; Lenis stays encapsulated here
      // and reacts to that single attribute — no cross-island coupling.
      const syncScrollLock = () => {
        const open = root.dataset.overlay === 'index' || root.dataset.overlay === 'work';
        if (lenis) {
          if (open) lenis.stop();
          else lenis.start();
        }
        root.style.overflow = open ? 'hidden' : '';
      };
      new MutationObserver(syncScrollLock).observe(root, {
        attributes: true,
        attributeFilter: ['data-overlay'],
      });
      syncScrollLock();
    </script>
  </body>
</html>
