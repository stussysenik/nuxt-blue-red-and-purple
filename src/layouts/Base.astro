---
// Reset ships via the vendored Tachyons preflight (uno.config.ts) — no extra
// reset import, so nothing fights the kernel. Fonts + base tokens + the four
// mode kernels are the design truth loaded globally.
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/modes/essential.css';
import '../styles/modes/brutal.css';
import '../styles/modes/clay.css';
import '../styles/modes/generative.css';
import { ThemeToggle } from '../components/theme-toggle';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // Top-centre chrome slot. 'index' → the "Template index" pill that opens the
  // full-screen Project Index (/works). 'close' → the same slot as a plain Close
  // (→ home), used by /works itself so the label swaps in place.
  // 'work' → a single fixed mono `← INDEX` link, top-left, and nothing else: a
  // work page IS the recreation, so every other portfolio mark (corner mark,
  // theme toggle, centred pill) is withheld rather than laid over the artwork.
  chrome?: 'index' | 'close' | 'work';
}

const {
  title = '*blue red + purple/',
  description = 'A design agency with one specialization: one-page systems. One fixed content structure, four interchangeable design systems — switched live.',
  noindex = false,
} = Astro.props;

// Persistent chrome — identical coordinates on every page (home · index ·
// inquiry · theme), so wayfinding is the same solved problem everywhere and a
// prospect is always one click from getting in touch. The current page is
// resolved from the path so its nav item reads aria-current instead of linking
// back to where you already are. `chrome` is still accepted (work pages pass it)
// but no longer branches the layout — the bar is the same for all.
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onHome = pathname === '/';
const onIndex = pathname === '/works';
const INQUIRY = 'mailto:hi@blueredandpurple.world';
---

<!doctype html>
<html lang="en" data-mode="generative">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- theme-color follows the paper core, never a forbidden hue (color law) -->
    <meta name="theme-color" content="#F7F3EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16130F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/archivo-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content="blue red + purple" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blueredandpurple.world/" />
    <meta property="og:image" content="https://blueredandpurple.world/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- No-FOUC bootstrap: resolve theme before first paint (mode default = generative). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

  </head>
  <body>
    <!-- ── Global pinned chrome — one bar, identical on every page. The brand
         mark is home, Index reaches the catalogue, the inquiry CTA is always a
         click away (the negotiation path), and the theme toggle rides along.
         All of it sits in the reserved --chrome-band above page content, so it
         never lands on a recreation's own layout. ── -->
    <header class="chrome">
      <div class="chrome__bar">
        <nav class="chrome__group" aria-label="Primary">
          <a
            href="/"
            class="chrome__home"
            aria-label="blue red + purple — home"
            aria-current={onHome ? 'page' : undefined}
          >
            ✳
          </a>
          <a
            href="/works"
            class="chrome__link font-mono"
            aria-current={onIndex ? 'page' : undefined}
          >
            Index
          </a>
        </nav>
        <div class="chrome__group">
          <a href={INQUIRY} class="chrome__cta font-mono">
            Get in touch<span aria-hidden="true"> ↗</span>
          </a>
          <ThemeToggle client:load />
        </div>
      </div>
    </header>

    <slot />

    <!-- Lenis smooth scroll on its own rAF loop — no GSAP. Native scroll under
         reduced-motion. Band scroll reveals are pure CSS (base.css, guarded by
         @supports animation-timeline: view()), so no JS scroll listener runs
         here and zero GSAP bytes ship on any page. -->
    <script>
      import Lenis from 'lenis';

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const lenis = new Lenis({ smoothWheel: true });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>

    <style>
      /* Global pinned chrome. One bar, identical on every page. Composes only
         from kernel custom properties and snaps to the shared layout tokens
         (--chrome-inset / --chrome-band). A full-viewport, click-through
         overlay: children opt back into pointer events. */
      .chrome {
        position: fixed;
        inset: 0;
        z-index: 5;
        pointer-events: none;
        color: var(--ink);
      }
      .chrome a,
      .chrome theme-toggle {
        pointer-events: auto;
      }

      /* The bar spans the reserved band, flush to the safe-area insets, brand
         mark left, inquiry + theme right. justify-content pins the two groups to
         the edges so the coordinates are identical page to page. */
      .chrome__bar {
        position: absolute;
        top: max(var(--chrome-inset), env(safe-area-inset-top));
        left: max(var(--chrome-inset), env(safe-area-inset-left));
        right: max(var(--chrome-inset), env(safe-area-inset-right));
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2);
      }
      .chrome__group {
        display: flex;
        align-items: center;
        gap: var(--space-3);
      }

      /* The ✳ brand mark is home — display weight, the site's signature glyph. */
      .chrome__home {
        font-family: var(--font-display);
        font-weight: var(--wght-display);
        font-size: 1.4rem;
        line-height: 1;
        color: var(--ink);
        text-decoration: none;
        transition: opacity var(--dur) var(--ease);
      }

      /* Index + inquiry: plain tracked mono, the ink/paper duotone (colour law),
         no chip, no tail. The CTA carries a hairline underline so the conversion
         path reads as the action without shouting. */
      .chrome__link,
      .chrome__cta {
        font-size: var(--type-label);
        line-height: 1;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
        transition: opacity var(--dur) var(--ease);
      }
      .chrome__cta {
        border-bottom: 1.5px solid currentColor;
        padding-bottom: 0.15em;
      }

      /* You are here: the matching item steps back rather than link to itself. */
      .chrome__home[aria-current='page'],
      .chrome__link[aria-current='page'] {
        opacity: 0.4;
        pointer-events: none;
      }

      .chrome__home:focus-visible,
      .chrome__link:focus-visible,
      .chrome__cta:focus-visible {
        opacity: 1;
        outline: var(--border-w, 2px) solid var(--ink);
        outline-offset: 3px;
      }
      /* Hover dim only on real hover pointers — never latched on touch. */
      @media (hover: hover) {
        .chrome__home:hover,
        .chrome__link:hover,
        .chrome__cta:hover {
          opacity: 0.6;
        }
      }

      /* Narrow phones: tighten the tracking + gaps so the two groups still clear
         each other on a 320px stage. */
      @media (max-width: 26rem) {
        .chrome__group {
          gap: var(--space-2);
        }
        .chrome__link,
        .chrome__cta {
          letter-spacing: 0.06em;
        }
      }
    </style>
  </body>
</html>
