---
// Reset ships via the vendored Tachyons preflight (uno.config.ts) — no extra
// reset import, so nothing fights the kernel. Fonts + base tokens + the four
// mode kernels are the design truth loaded globally.
import '../styles/fonts.css';
import '../styles/base.css';
import '../styles/modes/essential.css';
import '../styles/modes/brutal.css';
import '../styles/modes/clay.css';
import '../styles/modes/generative.css';
import { ThemeToggle } from '../components/theme-toggle';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  // Top-centre chrome slot. 'index' → the "Template index" pill that opens the
  // full-screen Project Index (/works). 'close' → the same slot as a plain Close
  // (→ home), used by /works itself so the label swaps in place.
  // 'work' → a single fixed mono `← INDEX` link, top-left, and nothing else: a
  // work page IS the recreation, so every other portfolio mark (corner mark,
  // theme toggle, centred pill) is withheld rather than laid over the artwork.
  chrome?: 'index' | 'close' | 'work';
}

const {
  title = '*blue red + purple/',
  description = 'A design agency with one specialization: one-page systems. One fixed content structure, four interchangeable design systems — switched live.',
  noindex = false,
  chrome = 'index',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-mode="generative">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <!-- theme-color follows the paper core, never a forbidden hue (color law) -->
    <meta name="theme-color" content="#F7F3EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16130F" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/archivo-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content="blue red + purple" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://blueredandpurple.world/" />
    <meta property="og:image" content="https://blueredandpurple.world/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- No-FOUC bootstrap: resolve theme before first paint (mode default = generative). -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const stored = localStorage.getItem('theme');
        const dark =
          stored === 'dark' ||
          (!stored && matchMedia('(prefers-color-scheme: dark)').matches);
        root.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

  </head>
  <body>
    <!-- ── Global pinned chrome. The centred slot is the wayfinding anchor: the
         "Template index" pill (→ /works) on content pages, or Close (→ home) on
         the index itself, swapping in place. The corner mark stays; the home
         slash-mark is archived (below). ── -->
    <header class="chrome">
      <!-- Archived: the top-left /// home mark. Restore by uncommenting — it was
           the link back to `/`. Wayfinding now runs through the centred index
           pill and the index's Close, so a persistent home mark is redundant.
      <a href="/" class="slash-mark" aria-label="blue red + purple — home">
        <span></span><span></span><span></span>
      </a>
      -->
      {
        chrome === 'work' ? (
          <a href="/works" class="chrome-back font-mono">
            ← Index
          </a>
        ) : chrome === 'close' ? (
          <a href="/" class="chrome-index chrome-index--close font-mono">
            Close
          </a>
        ) : (
          <a href="/works" class="chrome-index">
            Project Index
          </a>
        )
      }
      {chrome !== 'work' && <span class="corner-mark" aria-hidden="true">✳</span>}
    </header>
    {chrome !== 'work' && <ThemeToggle client:load />}

    <slot />

    <!-- Lenis smooth scroll wired into the GSAP ScrollTrigger ticker; native
         scroll + no reveals under reduced-motion. -->
    <script>
      import Lenis from 'lenis';

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lenis = reduced ? null : new Lenis({ smoothWheel: true });

      if (lenis) {
        // GSAP drives Lenis's rAF and Lenis's virtual scroll updates
        // ScrollTrigger, so scroll-driven reveals read the smoothed position.
        // GSAP loads only when motion is allowed (dynamic import, like the wheel).
        void (async () => {
          const [{ gsap }, { ScrollTrigger }] = await Promise.all([
            import('gsap'),
            import('gsap/ScrollTrigger'),
          ]);
          gsap.registerPlugin(ScrollTrigger);
          lenis.on('scroll', ScrollTrigger.update);
          gsap.ticker.add((time) => lenis.raf(time * 1000)); // ticker seconds → Lenis ms
          gsap.ticker.lagSmoothing(0);

          // Content bands rise + fade as they enter — transform/opacity only
          // (GPU-bound), once each. The default (no-JS / reduced-motion) state is
          // fully visible, so this only ever adds motion, never hides content.
          for (const band of document.querySelectorAll('.band')) {
            gsap.from(band, {
              opacity: 0,
              y: 32,
              duration: 0.8,
              ease: 'power2.out',
              scrollTrigger: { trigger: band, start: 'top 85%', once: true },
            });
          }
        })();
      }
    </script>

    <style>
      /* Global pinned chrome (moved out of the home page so work pages inherit
         the identical nav). Composes only from kernel custom properties, and
         snaps to the shared layout tokens (--chrome-inset). A full-viewport,
         click-through overlay: children opt back into pointer events. Sits above
         the theme toggle (z 4). */
      .chrome {
        position: fixed;
        inset: 0;
        z-index: 5;
        pointer-events: none;
        color: var(--ink);
      }
      .chrome a,
      .chrome > span {
        pointer-events: auto;
      }

      /* Centred index anchor. On content pages: clean plain-text wayfinding —
         the label in --ink display type, no chip, no tail, staying inside the
         ink/paper duotone (colour law). On the index: plain Close text
         (--close modifier). */
      .chrome-index {
        position: absolute;
        top: max(var(--chrome-inset), env(safe-area-inset-top));
        left: 50%;
        transform: translateX(-50%);
        display: inline-flex;
        align-items: center;
        padding: var(--space-1) var(--space-2);
        font-family: var(--font-display);
        font-weight: var(--wght-body);
        font-size: var(--type-meta);
        line-height: 1;
        letter-spacing: 0.01em;
        color: var(--ink);
        text-decoration: none;
        white-space: nowrap;
        transition: opacity var(--dur) var(--ease);
      }
      .chrome-index:hover,
      .chrome-index:focus-visible {
        opacity: 0.6;
        outline: none;
      }
      /* Index → Close: plain tracked text, no chip, no tail. */
      .chrome-index--close {
        padding: var(--space-2) var(--space-3);
        color: var(--ink);
        background: none;
        text-transform: uppercase;
        letter-spacing: 0.22em;
        transition: color var(--dur) var(--ease);
      }
      .chrome-index--close::after {
        display: none;
      }
      .chrome-index--close:hover,
      .chrome-index--close:focus-visible {
        opacity: 1;
        color: var(--spot);
      }

      /* Work pages: the lone mark the portfolio leaves on a recreation. Sits in
         the corner-mark slot (the reserved chrome corner sitewide) so it clears
         the source navs, which are top-left in nearly every reconstruction. */
      .chrome-back {
        position: absolute;
        top: max(var(--chrome-inset), env(safe-area-inset-top));
        right: max(var(--chrome-inset), env(safe-area-inset-right));
        font-size: var(--type-label);
        line-height: 1;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        transition: opacity var(--dur) var(--ease);
      }
      .chrome-back:hover,
      .chrome-back:focus-visible {
        opacity: 0.6;
      }

      .corner-mark {
        position: absolute;
        top: max(var(--chrome-inset), env(safe-area-inset-top));
        right: max(var(--chrome-inset), env(safe-area-inset-right));
        font-family: var(--font-display);
        font-weight: var(--wght-display);
        font-size: 1.4rem;
        color: var(--ink);
      }
    </style>
  </body>
</html>
