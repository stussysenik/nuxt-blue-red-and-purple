---
// Bridges build-time collection data to the two client islands. Works are
// serialized once into a JSON script tag both islands read — Lit islands run in
// the browser and cannot import Astro content collections. Order: the live
// client (smac, real) leads, then most-recent studies, then alphabetical — a
// pure, deterministic sort so the (N#) numbering is stable across builds.
import { getCollection } from 'astro:content';
import { ProjectIndex } from './project-index';
import { WorkPage } from './work-page';

const works = (await getCollection('works'))
  .map((entry) => entry.data)
  .toSorted(
    (a, b) =>
      Number(b.real ?? false) - Number(a.real ?? false) ||
      b.year - a.year ||
      a.title.localeCompare(b.title),
  );

// Escape `<` so the payload can never terminate the script element early.
const payload = JSON.stringify(works).replace(/</g, '\\u003c');
---

<script type="application/json" id="works-data" is:inline set:html={payload} />
<ProjectIndex client:load />
<WorkPage client:load />
