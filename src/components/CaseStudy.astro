---
// CaseStudy — the shared shell every bespoke work page composes into.
//
// The page structure is fixed (back → head → lede → narrative → stage → facts
// → notes → source) so thirteen layout-bespoke reconstructions still read as
// one portfolio. The *stage* is the point: a measured frame — ruler ticks on
// two edges, corner marks, a mono caption — holding the work's signature
// layout rebuilt 1:1 in our own HTML/CSS (the default slot). The chrome frames
// the craft the way a plate frames a specimen; it never touches the slot's
// internals.
//
// Composes only from kernel custom properties; the single exception is
// --work-accent (the work's own colour, grafted inline and exempt from the
// colour law — "artwork carries colour").
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>['data'];
  // Mono caption under the stage frame, e.g. 'Reconstruction — signature layout, 1:1'.
  stageLabel?: string;
}

const { work, stageLabel = 'Reconstruction — signature layout, rebuilt in-kernel' } = Astro.props;
const accent = work.palette?.[0];
---

<article class="case" style={accent ? `--work-accent:${accent}` : undefined}>
  <a class="back" href="/works">← Index</a>

  <header class="head">
    <p class="eyebrow font-mono ttu tracked">{work.category}</p>
    <h1 class="title">{work.title}</h1>
    <hr class="rule" />
  </header>

  <p class="lede lh-copy">{work.summary}</p>

  <slot name="narrative" />

  <figure class="stage">
    <span class="stage__ruler stage__ruler--x" aria-hidden="true"></span>
    <span class="stage__ruler stage__ruler--y" aria-hidden="true"></span>
    <div class="stage__canvas">
      <slot />
    </div>
    <figcaption class="stage__meta font-mono">
      <span>{stageLabel}</span>
      {work.mechanic && <span class="stage__mech">{work.mechanic}</span>}
    </figcaption>
  </figure>

  <slot name="notes" />

  <footer class="foot">
    {
      work.palette?.length && (
        <ul class="swatches font-mono">
          {work.palette.map((c) => (
            <li>
              <span class="chip" style={`background-color:${c}`} />
              {c}
            </li>
          ))}
        </ul>
      )
    }
    {work.source && <p class="source font-mono">Source — {work.source}</p>}
  </footer>
</article>

<style>
  .case {
    --accent: var(--work-accent, var(--spot, var(--ink)));
    position: relative;
    z-index: 1;
    max-width: 72rem;
    margin: 0 auto;
    padding: clamp(4.5rem, 12vh, 8rem) clamp(1.4rem, 5vw, 4rem) 6rem;
    color: var(--ink);
  }

  .back {
    display: inline-block;
    margin-bottom: clamp(2rem, 6vh, 4rem);
    font-family: var(--font-mono);
    font-size: var(--type-label);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur, 0.25s) var(--ease, ease);
  }
  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }

  .eyebrow {
    font-size: var(--type-label);
    color: var(--ink-2);
  }
  .title {
    font-family: var(--font-display);
    font-weight: var(--wght-display, 700);
    font-size: clamp(2.6rem, 10vw, 7rem);
    line-height: 0.98;
    letter-spacing: var(--tracking-display, -0.02em);
    margin: 0.3rem 0 1.4rem;
  }
  .rule {
    height: var(--border-w, 2px);
    background-color: var(--accent);
    border: none;
    margin: 0 0 2.4rem;
  }

  .lede {
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-1, var(--ink));
    max-width: 42rem;
    margin: 0 0 2.8rem;
  }

  /* Narrative / notes prose — slotted sections opt in via class="prose". */
  .case :global(.prose) {
    max-width: 42rem;
    margin: 0 0 2.8rem;
  }
  .case :global(.prose h2) {
    font-family: var(--font-mono);
    font-size: var(--type-label);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.6rem;
    padding-left: 0.9rem;
    border-left: var(--border-w, 2px) solid var(--accent);
  }
  .case :global(.prose p) {
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--ink-1, var(--ink));
    margin: 0 0 1em;
  }
  .case :global(.prose blockquote) {
    margin: 1.4em 0;
    padding-left: 1.1rem;
    border-left: var(--border-w, 2px) solid var(--accent);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.5;
    color: var(--ink);
  }
  .case :global(.prose cite) {
    display: block;
    margin-top: 0.5em;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  /* ── The measured stage ── */
  .stage {
    --tick: var(--line, var(--ink-2));
    position: relative;
    margin: 0 0 3rem;
    padding: 1.1rem 0 0 1.1rem; /* room for the two rulers */
  }
  .stage__ruler {
    position: absolute;
    pointer-events: none;
  }
  /* Minor tick every 8px, major every 64px — real measurements, not decor. */
  .stage__ruler--x {
    inset: 0 0 auto 1.1rem;
    height: 1.1rem;
    background-image:
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(90deg, var(--tick) 0 1px, transparent 1px 8px);
    background-size:
      100% 100%,
      100% 45%;
    background-position:
      0 0,
      0 100%;
    background-repeat: no-repeat;
  }
  .stage__ruler--y {
    inset: 1.1rem auto 0 0;
    width: 1.1rem;
    background-image:
      repeating-linear-gradient(180deg, var(--tick) 0 1px, transparent 1px 64px),
      repeating-linear-gradient(180deg, var(--tick) 0 1px, transparent 1px 8px);
    background-size:
      100% 100%,
      45% 100%;
    background-position:
      0 0,
      100% 0;
    background-repeat: no-repeat;
  }
  .stage__canvas {
    position: relative;
    /* The canvas is the query container: slotted reconstructions measure
       themselves in cq* units against the stage, not the viewport. */
    container-type: inline-size;
    border: 1px solid var(--line, var(--ink-2));
    background-color: var(--paper-1, var(--paper));
    overflow: hidden;
  }
  .stage__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 2rem;
    margin: 0.7rem 0 0 1.1rem;
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
  .stage__mech {
    text-align: right;
    max-width: 34rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }
  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--type-label);
    color: var(--ink-1);
  }
  .chip {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--line, var(--ink-2));
    flex: none;
  }
  .source {
    margin: 0;
    font-size: var(--type-label);
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
</style>
