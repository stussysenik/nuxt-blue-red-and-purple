---
// B970 — bespoke in-kernel reconstruction.
//
// The page IS the recreation: the reference's signature layout fills the
// viewport edge-to-edge, exactly as the source frames itself. Every word the
// page owns lives in one band on the top baseline, set across a twelve-column
// grid as 3/3/6 — identity stack, italic display title with its roman credit,
// and one paragraph closed by a Read more link. Everything beneath the band is
// the committed film still, run full bleed to all four edges. The mechanic is
// live where the source is live — Read more extends the essay in place; the
// band never descends into the field. Single-screen by concept (as skrillex):
// the band and the full-bleed still are the whole page, so it fills 100svh and
// grows — min-height, never a max-height trap — rather than inventing scroll.
//
// Reference (internal, never shipped): refs/works/b970.jpg, 1600×1000.
// ref-geometry degenerates here (design.md §Known tool limits): the ground it
// detects (L=127) is the film still itself, not paper, so it collapses the
// frame into one 1000px "row" and reports the portrait as the "central block".
// Every number below was read off the jpg by eye and with per-pixel probes
// instead — thresholding for the white type (L>205) against the still, which
// separates the band cleanly where the tool's page-wide ground cannot.
//
// Archived case-study copy (removed from DOM 2026-07-17):
//
//   The signature —
//   The whole voice of the page is one band across the top: a wordmark with two
//   underlined links, an italic serif title over its roman credit, and a
//   four-line essay — three, three and six columns of a twelve-column grid, all
//   hung from the same baseline. The remaining ninety percent of the viewport
//   belongs to a full-bleed monochrome still, and the text never descends into
//   it. One Read more link is the only door the band offers.
//
//   Study notes —
//   The 3/3/6 split works because the columns widen with the weight of their
//   content — a two-line identity, a two-line caption, a full paragraph — so the
//   band reads left to right as an accelerating sentence. Pinning all three to
//   one baseline is what buys the full-bleed image its silence: the eye clears
//   the text in a single pass and drops into the still with nothing left to
//   negotiate. The serif display against semi-mono captions keeps the registers
//   legible even at one shared type size.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('works', 'b970');
const w = entry!.data;
---

<Base title={`${w.title} — *blue red + purple/`} chrome="work">
  <main class="site">
    <img
      class="art"
      src={w.image}
      alt={`${w.title} film still`}
      width="1600"
      height="1000"
      decoding="async"
    />
    <div class="scrim" aria-hidden="true"></div>

    <div class="band chrome-safe">
      <header class="band__id">
        <span class="band__wordmark">{w.title} Archive</span>
        <span class="band__links" aria-hidden="true">
          <u>Contact</u>, <u>IG</u>
        </span>
      </header>

      <div class="band__caption">
        <em class="band__title">Aliquam in tempus felis</em>
        <span class="band__credit font-mono">{w.title} · 16MM · {w.year}</span>
      </div>

      <div class="band__essay">
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer feugiat, arcu nec
          porttitor dignissim, sem urna dictum lorem, vel egestas nisl justo eu massa. Curabitur
          sit amet ligula id sapien vulputate faucibus.
        </p>
        <p class="band__extra">
          Etiam consequat, mauris a laoreet volutpat, dui nibh porta est, non congue augue risus
          nec velit. Nam in tortor sed ipsum tincidunt maximus. Suspendisse potenti.
        </p>
        <button class="band__more" type="button" aria-expanded="false">Read more</button>
      </div>
    </div>

    <span class="site__plate font-mono ttu" aria-hidden="true">{w.title} · {w.category} · {w.year}</span>
  </main>
</Base>

<script>
  // Read more: extend the essay in place, band stays put. Live, like the source.
  const more = document.querySelector<HTMLButtonElement>('.band__more');
  const extra = document.querySelector<HTMLElement>('.band__extra');
  more?.addEventListener('click', () => {
    const open = extra?.toggleAttribute('data-open') ?? false;
    more.setAttribute('aria-expanded', String(open));
    more.textContent = open ? 'Read less' : 'Read more';
  });
</script>

<style>
  /* The rebuilt room, now the whole page: the committed film still bleeds to
     all four edges and every owned word sits in one top band. The page is its
     own query container — the stage used to provide one, so every cq* unit below
     would silently re-resolve against the viewport without this. min-height, so
     the frame grows with content instead of trapping it at one screen; the ink
     ground is the still's load-in skeleton. */
  .site {
    container-type: inline-size;
    position: relative;
    min-height: 100svh;
    background-color: var(--ink);
    color: var(--paper);
  }

  /* The lone chrome mark rides the top-right over the ink scrim below, so it
     inverts to --paper or it lands ink-on-ink on the dark field. */
  :global(.chrome-back) {
    color: var(--paper);
  }

  /* The artwork, now the committed still itself: full-bleed, covering every edge
     of the (grown) page — absolute inset:0 stretches to the band's flow height,
     so there is never a gap below the fold. Fades in over the ink ground on
     first render (no JS — @starting-style), so there is no flash before bytes. */
  .art {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  @starting-style {
    .art {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .art {
      transition: none;
    }
  }

  /* A top-down ink scrim under the band only: the reference's type sat on the
     darker head of the still, so this keeps the paper band — and the pinned
     ← Index — legible over any brightness of the committed image without tinting
     the field below. Ink-based, so it stays inside the duotone (colour law). */
  .scrim {
    position: absolute;
    inset: 0 0 auto 0;
    height: 42%;
    z-index: 0;
    pointer-events: none;
    background-image: linear-gradient(
      180deg,
      color-mix(in oklab, var(--ink) 78%, transparent),
      transparent
    );
  }

  /* Transcribed from the reference at 1600×1000. The 3/3/6 grid is measured, not
     assumed: ink starts x29 / x417 / x808 and the essay's longest line ends
     x1566, which solves to a 12-track grid spanning x29→1568 at a 129.8px pitch
     — so column-gap 1.2% (18.6px) puts columns 4 and 7 within a pixel of their
     measured starts. One type size serves the whole band (capH 13px = 1.184cqw
     at Archivo's 0.686 cap ratio); leading 24px = 1.267. The band is in normal
     flow and opts into the chrome band (.chrome-safe), so its first line clears
     the pinned marks instead of climbing into the reserved strip. */
  .band {
    position: relative;
    z-index: 1;
    padding-inline: 1.8% 2%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 1.2%;
    font-size: clamp(0.8rem, 1.184cqw, 1.25rem);
    line-height: 1.267;
  }
  .band__id {
    grid-column: 1 / 4;
    display: flex;
    flex-direction: column;
  }
  /* Measured: baseline y70, underline y71→73. */
  .band__links u {
    text-underline-offset: 0.18em;
  }

  .band__caption {
    grid-column: 4 / 7;
    display: flex;
    flex-direction: column;
  }
  /* The pairing the source trades on: italic display over a semi-mono roman
     credit, at the shared band size. Balanced so the two-word title never leaves
     an orphan against the narrow column. */
  .band__title {
    font-family: var(--font-display);
    font-style: italic;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }
  /* The source sets this credit in the same serif roman as the band; our kernel
     answers that register shift with mono, matched on cap height not glyph width:
     IBM Plex Mono's 0.698 cap against Archivo's 0.686 → 0.983em lands its caps on
     the band's 13px exactly. */
  .band__credit {
    font-size: 0.983em;
    letter-spacing: 0.03em;
  }

  .band__essay {
    grid-column: 7 / 13;
  }
  .band__essay p {
    margin: 0;
    max-width: 42ch;
  }
  .band__extra {
    display: none;
  }
  .band__extra[data-open] {
    display: block;
    margin-top: 1.3em;
  }
  .band__more {
    margin-top: 1.3em;
    padding: 0;
    background: none;
    border: none;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  /* --spot resolves to --ink in the essential and generative kernels, which on
     this inverted sheet would draw an ink ring on an ink field. --paper is the
     only value that survives every mode here. */
  .band__more:focus-visible {
    outline: var(--border-w, 2px) solid var(--paper);
    outline-offset: 2px;
  }

  /* Film-slate credit for the still — mono, bottom-left, quiet, real metadata. */
  .site__plate {
    position: absolute;
    left: 1.8%;
    bottom: 4%;
    z-index: 1;
    font-size: var(--type-meta, 0.65rem);
    letter-spacing: 0.14em;
    color: color-mix(in oklab, var(--paper) 62%, transparent);
  }

  /* Phone: the source layout adapting, not a second design. The band is still
     one strip hung from the top and the still still takes the field below it —
     but three columns of a twelve-column grid cannot hold a wordmark at this
     width, so the 3/3/6 sentence runs top-to-bottom instead of left-to-right,
     keeping its reading order and one shared type size. */
  @container (max-width: 40rem) {
    .band {
      grid-template-columns: 1fr;
      row-gap: 1.3em;
      font-size: 0.95rem;
    }
    .band__id,
    .band__caption,
    .band__essay {
      grid-column: 1;
    }
    .band__essay p {
      max-width: none;
    }
    /* The single-column band can run long on a short phone; keep the slate from
       colliding with the essay by letting it ride just under the field's edge. */
    .site__plate {
      bottom: 2.5%;
    }
  }
</style>
