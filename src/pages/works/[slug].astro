---
// Real work page (SPEC reframed: works are routes now, not layered overlays).
// One static page per collection entry via getStaticPaths — an individually
// controllable surface while designing; the JSON stays the white-label data
// source that populates it. The work's own palette accent grafts onto the mode
// kernel so two works read visibly distinct through the same template. Local
// assets + attribution only: `source` is text, never a hotlink or outbound link.
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = (async () => {
  // Slugs with a bespoke, hand-built reconstruction page (works/<slug>.astro) opt
  // out of this generic template so the two routes never emit the same path. Add a
  // slug here the moment its dedicated file lands. Declared inside getStaticPaths:
  // Astro hoists this function into its own scope, so module-body consts it closes
  // over are undefined at call time.
  const BESPOKE = new Set(['smac']);
  const works = await getCollection('works');
  return works
    .filter((entry) => !BESPOKE.has(entry.data.slug))
    .map((entry) => ({
      params: { slug: entry.data.slug },
      props: { work: entry.data },
    }));
}) satisfies GetStaticPaths;

const { work } = Astro.props;
const accent = work.palette?.[0];
---

<Base title={`${work.title} — *blue red + purple/`}>
  <article class="work" style={accent ? `--work-accent:${accent}` : undefined}>
    <a class="back" href="/works">← Index</a>

    <header class="head">
      <p class="eyebrow font-mono">{work.category} · {work.year}</p>
      <h1 class="title">{work.title}</h1>
      <hr class="rule" />
    </header>

    <figure class="hero">
      <img src={work.image} alt={`${work.title} — ${work.category}`} />
    </figure>

    <p class="summary lh-copy">{work.summary}</p>

    <div class="facts">
      {work.mechanic && (
        <section class="fact">
          <h2 class="fact__key font-mono">Mechanic</h2>
          <p class="fact__body">{work.mechanic}</p>
        </section>
      )}
      {work.palette?.length && (
        <section class="fact">
          <h2 class="fact__key font-mono">Palette</h2>
          <ul class="swatches font-mono">
            {work.palette.map((c) => (
              <li><span class="chip" style={`background-color:${c}`}></span>{c}</li>
            ))}
          </ul>
        </section>
      )}
    </div>

    {work.source && <p class="source font-mono">Source — {work.source}</p>}
  </article>
</Base>

<style>
  /* Composes only from kernel custom properties (the Lit-island escape hatch);
     the single exception is --work-accent, a work colour injected inline and
     exempt from the colour law (SPEC: "artwork carries colour"). */
  .work {
    --accent: var(--work-accent, var(--spot, var(--ink)));
    position: relative;
    z-index: 1;
    max-width: 64rem;
    margin: 0 auto;
    padding: clamp(4.5rem, 12vh, 8rem) clamp(1.4rem, 5vw, 4rem) 6rem;
    color: var(--ink);
  }

  /* Clean text return — no bar, no gradient, no artifact. */
  .back {
    display: inline-block;
    margin-bottom: clamp(2rem, 6vh, 4rem);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-decoration: none;
    transition: color var(--dur, 0.25s) var(--ease, ease);
  }
  .back:hover,
  .back:focus-visible {
    color: var(--accent);
  }

  .eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  .title {
    font-family: var(--font-display);
    font-weight: var(--wght-display, 700);
    font-size: clamp(2.6rem, 10vw, 7rem);
    line-height: 0.98;
    letter-spacing: var(--tracking-display, -0.02em);
    margin: 0.3rem 0 1.4rem;
  }
  .rule {
    height: var(--border-w, 2px);
    background-color: var(--accent);
    border: none;
    margin: 0 0 2.4rem;
  }

  .hero {
    margin: 0 0 2.6rem;
    aspect-ratio: 16 / 9;
    background-color: var(--paper-1, var(--paper));
    overflow: hidden;
  }
  .hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .summary {
    font-size: clamp(1.05rem, 2.4vw, 1.4rem);
    line-height: 1.5;
    color: var(--ink-1, var(--ink));
    max-width: 42rem;
    margin: 0 0 2.8rem;
  }

  .facts {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }
  .fact__key {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin: 0 0 0.6rem;
    padding-left: 0.9rem;
    border-left: var(--border-w, 2px) solid var(--accent);
  }
  .fact__body {
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--ink-1, var(--ink));
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .swatches li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    color: var(--ink-1);
  }
  .chip {
    width: 1.4rem;
    height: 1.4rem;
    border-radius: var(--radius);
    border: 1px solid var(--line, var(--ink-2));
    flex: none;
  }

  .source {
    margin-top: 2.8rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--ink-2);
  }
</style>
