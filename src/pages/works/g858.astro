---
// G858 — bespoke in-kernel reconstruction (the page IS the recreation).
//
// The reference's signature layout fills the viewport edge-to-edge: one yellow
// journal card pinned top-left over a full-bleed wallpaper — a big grotesk
// wordmark, four dated drops (date left, drop tag right, one struck through),
// two pills splitting the card's bottom edge — and a chip dock bottom-right.
// The mechanic is live, not pictured: Shop slides a twelve-product overlay up
// over the whole room. The wallpaper is the committed photo itself, ghost-loaded
// full-bleed behind the card; products stay numbered specimen plates — the photo
// is our curated field, not the client's artwork. The work's two palette hexes
// (yellow, near-black) graft onto the room as --g-yellow/--g-black; chrome stays
// kernel ink, kept legible over the photo by a soft top scrim.
//
// Reference (internal, never shipped): refs/works/g858.jpg, 1600×1000. The
// ground is a dark forest photo (L=81), so ref-geometry degenerates — it locks
// onto the wallpaper and cannot isolate the yellow card. Read by eye:
//   card:  left x24 (1.5cqw), top y16 (1.6%), right x510 → width 486px (30.4cqw)
//   mark:  "Untitled-1" cap top y40 → baseline y126, true cap height ~86px.
//          86 ÷ Archivo's real cap (0.686em, read from public/fonts/
//          archivo-wght.woff2) = 125px type = 7.8cqw. Our "G858" is far shorter
//          than the source's ten glyphs — match the cap height, accept the
//          width delta.
//   entries: mono, cap ~14px ÷ Plex Mono cap (0.698em) = 20px = 1.25cqw; the
//          four drops step on an ~86px rule-to-rule pitch.
//   dock:  x1548→1588 (40px, 2.5cqw), y858→968 (~110px), four stacked chips.
// The room grounds in --paper with a --paper-1 wall; both invert with the theme
// alongside the top-right ← INDEX chrome, so it stays legible in either — unlike
// skrillex, this room does not force --ink as its own ground.
//
// Archived case-study copy (removed from DOM 2026-07-17):
//
//   The signature —
//   The whole site is one yellow card floating on a wallpaper. The card is a
//   journal — four dated drops, each with a mono tag on the right margin and one
//   struck through — and the shop never gets a page of its own: it slides up as
//   an overlay and leaves when dismissed. The photo does the atmosphere; the
//   card does every ounce of the interface.
//
//   Study notes —
//   The card earns its density because everything inside it sits on one mono
//   grid: dates flush left, drop tags flush right, hairline rules between
//   entries, two pills splitting the bottom edge evenly. Against that discipline
//   the wallpaper can be pure noise — and the overlay shop is the same move in
//   reverse, one dark plane sliding over the room instead of one yellow plane
//   floating on it.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('works', 'g858');
const w = entry!.data;
const [yellow, black] = w.palette ?? [];
const PRODUCTS = 12;
// Copy is lorem; the dated-drop structure (date left, tag right, one struck
// through) is the point the reference trades on.
const ENTRIES = [
  { date: 'Mar. 15', tag: 'Drop 01', copy: 'Lorem ipsum dolor sit amet, consectetur' },
  { date: 'Mar. 22', tag: 'Drop 02', copy: 'Sed do eiusmod tempor incididunt', sold: true },
  { date: 'Mar. 23', tag: 'Drop 03', copy: 'Ut labore et dolore magna aliqua' },
  { date: 'Aug. 3', tag: 'Drop 04', copy: 'Quis nostrud exercitation ullamco' },
];
---

<Base title={`${w.title} — *blue red + purple/`} chrome="work">
  <div class="site" style={`--g-yellow:${yellow};--g-black:${black}`}>
    <img
      class="wall"
      src={w.image}
      alt={`${w.title} wallpaper`}
      width="1600"
      height="1000"
      decoding="async"
    />
    <div class="scrim" aria-hidden="true"></div>

      <aside class="card">
        <p class="card__mark">{w.title}</p>
        <ol class="card__journal">
          {
            ENTRIES.map((e) => (
              <li class="entry font-mono">
                <span class="entry__date">{e.date}</span>
                <span class="entry__tag" data-sold={e.sold ? '' : undefined}>{e.tag}</span>
                <span class="entry__copy">{e.copy}</span>
              </li>
            ))
          }
        </ol>
        <div class="card__actions font-mono">
          <button class="pill card__shop" type="button" aria-expanded="false">Shop</button>
          <span class="pill">IG</span>
        </div>
      </aside>

      <div class="dock" aria-hidden="true"></div>

      <section class="shop" aria-label="Overlay shop" inert>
        <header class="shop__head font-mono ttu tracked">
          <span>Shop</span>
          <button class="shop__close" type="button">Close ×</button>
        </header>
        <ol class="shop__grid">
          {
            Array.from({ length: PRODUCTS }, (_, i) => (
              <li class="product">
                <span class="product__num font-mono">{String(i + 1).padStart(2, '0')}</span>
              </li>
            ))
          }
        </ol>
      </section>
  </div>
</Base>

<script>
  // Slide-up shop: one overlay, one open state, Escape closes.
  const site = document.querySelector<HTMLElement>('.site');
  const shop = site?.querySelector<HTMLElement>('.shop');
  const openBtn = site?.querySelector<HTMLButtonElement>('.card__shop');
  const closeBtn = site?.querySelector<HTMLButtonElement>('.shop__close');
  const set = (on: boolean) => {
    shop?.toggleAttribute('data-open', on);
    if (shop) shop.inert = !on;
    // While the modal shop owns the room, retire the page's ← Index: it would
    // otherwise sit (illegibly, and still focusable) behind the dark plane in the
    // exact corner as the shop's own Close. Restored on dismiss.
    document.documentElement.toggleAttribute('data-shop-open', on);
    openBtn?.setAttribute('aria-expanded', String(on));
    (on ? closeBtn : openBtn)?.focus();
  };
  openBtn?.addEventListener('click', () => set(true));
  closeBtn?.addEventListener('click', () => set(false));
  shop?.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
</script>

<style>
  /* The rebuilt room, now the whole page. Proportions transcribed from the
     reference: card pinned top-left at 30.4cqw, chip dock bottom-right,
     wallpaper everywhere else. The page is its own query container — the stage
     used to provide one, so cq* units would otherwise resolve against the
     viewport. --type is the one mono grid the card is built on (reference cap
     ~14px ÷ Plex Mono cap 0.698 = 20px = 1.25cqw); it is declared here and used
     on the children, because a cq* font-size on .site itself would resolve
     against an ancestor container, not .site. The card's longest copy line runs
     ~273px for 34 mono glyphs → ~13.6px face (cap ~9px = 0.85cqw). */
  .site {
    container-type: inline-size;
    position: relative;
    min-height: 100svh;
    background-color: var(--paper-1, var(--paper));
    color: var(--ink);
    --type: clamp(0.72rem, 0.85cqw, 0.95rem);
    font-size: var(--type);
  }
  /* Wallpaper: the committed photo itself, full-bleed behind the card — the room
     the source built with a photo, built with ours. The --paper-1 ground on
     .site is the load-in skeleton; the image fades in over it on first render
     (no JS — @starting-style), so nothing flashes before the bytes. */
  .wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  @starting-style {
    .wall {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall {
      transition: none;
    }
  }
  /* A soft paper scrim at the top, over the photo but under the card: keeps the
     top-right ← Index (kernel ink) legible over any brightness of the wallpaper
     without tinting the field. Paper-based, so it stays inside the duotone. */
  .scrim {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--chrome-band);
    z-index: 0;
    pointer-events: none;
    background-image: linear-gradient(
      180deg,
      color-mix(in oklab, var(--paper) 72%, transparent),
      transparent
    );
  }
  /* Card: reference left x24 (1.5cqw), width 486px (30.4cqw). The reference
     pinned it at y16, but our room carries a pinned ← Index the source never had,
     so the card opts into the shared chrome band — its top edge drops below the
     reserved strip. That is what clears the mark at every width (on a phone the
     90cqw card would otherwise run its top-right corner straight under ← Index).
     Internal padding 1em ≈ the reference's 20px inset off --type. */
  .card {
    position: absolute;
    inset: var(--chrome-band) auto auto 1.5%;
    z-index: 1;
    width: 30.4cqw;
    padding: 0.85em 1em 1em;
    background-color: var(--g-yellow, var(--spot));
    color: var(--g-black, var(--ink));
    border-radius: var(--radius);
  }
  /* Reference wordmark cap 86px = 125px type = 9.2× the 13.6px entry face;
     line-height 1, ~2em of air down to the first entry rule (baseline y126 →
     rule y180). "G858" is far shorter than the source's "Untitled-1" — cap
     height matches, glyph width is free. */
  .card__mark {
    margin: 0 0 2em;
    font-family: var(--font-display);
    font-weight: var(--wght-display, 700);
    font-size: 9.2em;
    line-height: 1;
    letter-spacing: var(--tracking-display, -0.02em);
  }
  .card__journal,
  .shop__grid {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Four drops on an ~86px rule-to-rule pitch (reference y180→266→…): a bold
     date row flush left with its drop tag flush right, then two copy lines. */
  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.3em 1em;
    padding: 0.7em 0 0.75em;
    border-top: 1px solid var(--g-black, var(--ink));
  }
  .entry__date {
    font-weight: 700;
  }
  .entry__tag[data-sold] {
    text-decoration: line-through;
  }
  .entry__copy {
    grid-column: 1 / -1;
    line-height: 1.3;
    opacity: 0.82;
  }
  .card__actions {
    display: flex;
    gap: 0.9em;
    margin-top: 1.4em;
  }
  .pill,
  .shop__close {
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .pill {
    flex: 1;
    padding: 0.7em 0;
    text-align: center;
    border: 1px solid var(--g-black, var(--ink));
    border-radius: 999px;
  }
  .card__shop:hover,
  .card__shop:focus-visible {
    background-color: var(--g-black, var(--ink));
    color: var(--g-yellow, var(--spot));
  }
  /* Chip dock: four stacked yellow chips, bottom-right. Reference x1548→1588
     (40px, 2.5cqw) × y858→968 (~110px, 6.9cqw), inset ~0.9% right / 3.2% up. */
  .dock {
    position: absolute;
    inset: auto 0.9% 3.2% auto;
    width: 2.5cqw;
    height: 6.9cqw;
    background-image: repeating-linear-gradient(
      var(--g-yellow, var(--spot)) 0 1.4cqw,
      transparent 1.4cqw 1.725cqw
    );
    border-radius: var(--radius);
  }
  /* The overlay shop: one dark plane, twelve plates, slides over everything. */
  /* While the modal shop owns the room the page's ← Index steps aside entirely —
     hidden and un-focusable — so the two exits never share the top-right corner
     and no focus leaks behind the plane. (visibility:hidden also drops it from
     the tab order; the shop is the sole affordance while open.) */
  :global(html[data-shop-open] .chrome-back) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Above the sitewide chrome (z 5): a full-screen modal legitimately covers the
     room — the source's shop "never gets a page of its own", it takes everything.
     .site is not a stacking context (position:relative, no z-index), so this z
     competes directly with the chrome in the root layer. */
  .shop {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    flex-direction: column;
    background-color: var(--g-black, var(--ink));
    color: var(--paper);
    translate: 0 101%;
    transition:
      translate var(--dur, 0.25s) var(--ease, ease),
      display var(--dur, 0.25s) allow-discrete;
  }
  /* Closed: fully out of layout. The old build translated the plane off-screen
     and clipped it with a root overflow clip; that trap is retired, so a merely
     translated plane would add a screen of dead scroll below the room. Leaving
     layout (display:none, discrete-animated) is the honest equivalent — it slides
     up from the bottom on open and is simply gone when closed. */
  .shop:not([data-open]) {
    display: none;
  }
  .shop[data-open] {
    translate: 0 0;
  }
  @starting-style {
    .shop[data-open] {
      translate: 0 101%;
    }
  }
  .shop__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4em 1.8em;
  }
  .shop__close {
    border: none;
    padding: 0;
    color: var(--g-yellow, var(--spot));
  }
  .shop__close:focus-visible,
  .card__shop:focus-visible {
    outline: var(--border-w, 2px) solid currentColor;
    outline-offset: 2px;
  }
  .shop__grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 0.9em;
    padding: 0 1.8em 1.8em;
  }
  .product {
    display: grid;
    place-items: center;
    color: var(--ink-2);
    background-color: var(--paper-1, var(--paper));
  }
  .product__num {
    font-size: 1.6em;
    color: inherit;
  }
  /* One product carries the accent — "artwork carries colour". */
  .product:nth-of-type(7) {
    background-color: var(--g-yellow, var(--spot));
    color: var(--g-black, var(--ink));
  }
  /* Phone: the source layout adapting, not a second design. A 30.4cqw card is
     ~114px at phone width — far too narrow for the journal — so it takes the
     width it needs; the dock scales up off the same edge. */
  @container (max-width: 40rem) {
    .card {
      width: 90cqw;
    }
    .dock {
      width: 8cqw;
      height: 22cqw;
      background-image: repeating-linear-gradient(
        var(--g-yellow, var(--spot)) 0 4.5cqw,
        transparent 4.5cqw 5.5cqw
      );
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .shop {
      transition: none;
    }
  }
</style>
