---
// The Project Index — a standalone, white-label concept page. Full-screen,
// centered, scrollable: big display-type title rows grouped under plain
// industry labels (restaurant, hotel, music …) over a blurred ghost of the
// hovered work. Driven entirely by the works collection (no hardcoded brand),
// so any set of works populates it. Each row navigates to its routed
// /works/[slug] page. Same deterministic sort inside each group as everywhere
// else — live client first, then newest, then alphabetical.
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { toRoman } from '../../lib/roman';

const works = (await getCollection('works'))
  .map((entry) => entry.data)
  .filter((w) => !w.hidden)
  .toSorted(
    (a, b) =>
      Number(b.real ?? false) - Number(a.real ?? false) ||
      b.year - a.year ||
      a.title.localeCompare(b.title),
  );

// Curated industry order; categories not listed yet fall to the end, A→Z.
const ORDER = ['restaurant', 'hotel', 'music', 'books', 'vintage'];
const rank = (c: string) => (ORDER.includes(c) ? ORDER.indexOf(c) : ORDER.length);
const groups = [...new Set(works.map((w) => w.category))]
  .toSorted((a, b) => rank(a) - rank(b) || a.localeCompare(b))
  .map((category) => ({
    category,
    items: works.filter((w) => w.category === category),
  }));

// Catalogue numbering follows the on-page reading order — groups top-to-bottom,
// items in the shared deterministic sort — so the numerals climb I → XIV straight
// down the index. Stable because both the group rank and the item sort are fixed.
const numeralOf = new Map(
  groups.flatMap((g) => g.items).map((w, i) => [w.slug, toRoman(i + 1)] as const),
);
---

<Base title="Project index — *blue red + purple/" chrome="close">
  <main class="index">
    <span class="index__ghost" aria-hidden="true"></span>

    <h1 class="visually-hidden">Project index</h1>
    {
      groups.map(({ category, items }) => (
        <section class="group">
          <h2 class="group__label font-mono ttu tracked">{category} store</h2>
          <ul class="index__list">
            {items.map((w) => (
              <li>
                <a
                  class="row"
                  href={`/works/${w.slug}`}
                  data-image={w.image}
                  aria-label={`${numeralOf.get(w.slug)} — ${w.category} store`}
                >
                  <span class="row__dot" aria-hidden="true" />
                  <span class="row__title">{numeralOf.get(w.slug)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Base>

<script>
  // The hovered/focused row drives the ghost backdrop — the only behavior this
  // page needs; the rows are plain links, so navigation is native.
  const ghost = document.querySelector<HTMLElement>('.index__ghost');
  const rows = document.querySelectorAll<HTMLElement>('.row');
  const paint = (url: string | null) => {
    if (ghost) ghost.style.backgroundImage = url ? `url("${url}")` : '';
  };
  for (const row of rows) {
    const show = () => paint(row.dataset.image ?? null);
    row.addEventListener('pointerenter', show);
    row.addEventListener('focus', show);
  }
  paint(rows[0]?.dataset.image ?? null);
</script>

<style>
  /* Composes only from kernel custom properties — the same escape hatch the
     rest of the site uses. No rogue hex, no arbitrary utilities. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .index {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    align-content: center;
    row-gap: clamp(2.2rem, 5.5vh, 3.6rem);
    color: var(--ink);
    /* Top/bottom padding clears the pinned chrome: the CLOSE anchor (top) and
       the theme toggle (bottom). When the groups outgrow the viewport the page
       top-anchors, so without this the first label tucks under CLOSE. */
    padding: clamp(4.5rem, 11vh, 7rem) 1rem clamp(4rem, 9vh, 5.5rem);
  }

  .group__label {
    text-align: center;
    font-size: var(--type-label);
    font-weight: 500;
    color: var(--ink-2);
    margin: 0 0 0.7rem;
  }

  /* Ghost backdrop — the hovered work's image, blurred and faint. */
  .index__ghost {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-position: center;
    background-size: cover;
    filter: blur(56px) saturate(1.1);
    opacity: 0.22;
    transform: scale(1.15);
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }

  .index__list {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    /* ≥44px hit target: the display numeral clears this on desktop, but the
       clamped mobile size (~31px) does not — min-height guarantees a tappable
       row at 320/375 without disturbing the desktop rhythm. */
    min-height: 2.75rem;
    padding: 0.1rem 0.6rem;
    text-decoration: none;
    color: var(--ink-2);
    transition: color 0.25s var(--ease);
  }
  .row:hover,
  .row:focus-visible {
    color: var(--ink);
    outline: none;
  }
  /* The "you are here" dot — the active element in the index's information
     architecture. It scales in on the hovered/focused row, a small satisfying
     mark that says which catalogue number you're about to open. */
  .row__dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background-color: currentColor;
    flex: none;
    opacity: 0;
    transform: scale(0.3);
    transition:
      opacity 0.25s var(--ease),
      transform 0.25s var(--ease);
  }
  .row:hover .row__dot,
  .row:focus-visible .row__dot {
    opacity: 1;
    transform: scale(1);
  }
  .row__title {
    font-family: var(--font-display);
    font-weight: var(--wght-display);
    font-size: clamp(1.8rem, 5.5vw, 4rem);
    line-height: 1.08;
    letter-spacing: var(--tracking-display);
    color: inherit;
    font-variant-numeric: tabular-nums;
  }
  /* Preview reveal — hovering a row wakes the background ghost: the work's image
     comes forward (clearer, nearer) so the cryptic numeral immediately suggests
     what it opens. Compositor-only (opacity / filter / transform). */
  .index:has(.row:hover) .index__ghost,
  .index:has(.row:focus-visible) .index__ghost {
    opacity: 0.34;
    filter: blur(40px) saturate(1.18);
    transform: scale(1.08);
  }
  @media (prefers-reduced-motion: reduce) {
    .index__ghost,
    .row,
    .row__dot {
      transition: none;
    }
  }
</style>
