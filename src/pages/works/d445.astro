---
// D445 — bespoke in-kernel reconstruction.
//
// The page IS the recreation: a book page, not a screen. A double-ruled border
// frames the composition, a single ragged-right column of running text holds the
// centre with footnote markers threaded through it, and the notes hang on a short
// rule at the foot of the frame — the printed page's own apparatus. The specimen
// plate is a real image sized to the measure; its one live mechanic is a lens —
// click to magnify in place, click to release. The affordance is the cursor, not
// a labelled control: the page never narrates its own switches.
//
// One route, one continuous composition: the frame is an object with a top and a
// foot, not a locked viewport. It stands at least one screen tall and grows with
// its content — a tall broadsheet is still one page. A slim reading-progress rule
// runs the inner margin, filling with scroll (CSS scroll-driven, progressive).
//
// No reference render exists for this work (refs/works/d445.jpg was never
// captured), so — unlike the measured pages in this set — the geometry here is
// NOT transcribed from a source at 1600px. It is composed from reading
// typography's own constants instead: a measure in the 60–72ch band, footnotes a
// step down on a short rule, a double-ruled frame inset from the edge. Honest
// first principles, not invented pixels.
//
// Archived case-study copy (removed from DOM 2026-07-17):
//
//   The signature —
//   Everything here defers to reading. The page draws its own border so the text
//   sits inside an object, not a window; the column takes exactly one comfortable
//   measure and no more; and the footnotes stay where footnotes belong, on a
//   short rule at the foot, addressed by number rather than by hover. Zoom is
//   withheld by default because zoom is a way of not reading — the control exists,
//   but the page opens in the state that trusts the reader.
//
//   Study notes —
//   A reading page is mostly restraint: the measure is the design decision, and
//   once it is set the margins, the footnote size, and the frame all fall out of
//   it. The mechanic had to be a toggle, not a hover, because a hover-zoom would
//   fire every time the eye crossed the plate on its way down the column — the
//   opposite of reading. So the default is off, the switch is explicit, and the
//   lens only arms once the reader asks for it.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('works', 'd445');
const w = entry!.data;
---

<Base title={`${w.title} — *blue red + purple/`} chrome="work">
  <main class="site">
    <div class="page">
      <span class="reader__progress" aria-hidden="true"></span>
      <article class="reader">
        <header class="reader__head">
          <p class="reader__folio font-mono">{w.title} · {w.category} · {w.year}</p>
          <h1 class="reader__title">Lorem Ipsum Dolor, Legere Non Videre</h1>
        </header>

        <div class="reader__col">
          <p>
            Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
            tempor incididunt ut labore et dolore magna aliqua.<sup
              ><a id="ref1" href="#fn1">1</a></sup
            > Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi
            ut aliquip ex ea commodo consequat, duis aute irure in reprehenderit.
          </p>

          <figure class="plate">
            <button class="plate__btn" type="button" aria-label="Magnify specimen plate">
              <img
                class="plate__img"
                src={w.image}
                alt={`${w.title} specimen plate`}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </button>
            <figcaption class="plate__cap font-mono">fig. i</figcaption>
          </figure>

          <p>
            Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia
            deserunt mollit anim id est laborum.<sup><a id="ref2" href="#fn2">2</a></sup>
            Sed ut perspiciatis unde omnis iste natus error sit voluptatem accusantium
            doloremque laudantium, totam rem aperiam eaque ipsa quae ab illo inventore
            veritatis et quasi architecto beatae vitae dicta sunt explicabo.
          </p>
        </div>

        <footer class="reader__notes">
          <ol class="reader__fn">
            <li id="fn1">
              Neque porro quisquam est qui dolorem ipsum quia dolor sit amet, consectetur.
              <a href="#ref1" aria-label="Back to reference 1">↩</a>
            </li>
            <li id="fn2">
              Ut enim ad minima veniam, quis nostrum exercitationem ullam corporis suscipit.
              <a href="#ref2" aria-label="Back to reference 2">↩</a>
            </li>
          </ol>
        </footer>
      </article>
    </div>
  </main>
</Base>

<script>
  // The one live mechanic: the specimen plate is a lens. A click magnifies it in
  // place; a second click releases it. Never a hover — a hover-zoom would fire on
  // every pass of the eye down the column, the opposite of reading. The plate is a
  // real button (keyboard-operable, aria-labelled) styled as bare artwork, so the
  // affordance is the cursor and focus ring, never a printed toggle.
  const plate = document.querySelector<HTMLElement>('.plate');
  const btn = plate?.querySelector<HTMLButtonElement>('.plate__btn');
  btn?.addEventListener('click', () => plate?.toggleAttribute('data-lens'));
</script>

<style>
  /* The rebuilt room, now a continuous page. min-height keeps the frame at least
     one screen tall; it grows with content instead of clipping at the fold — the
     page is an object with a foot, not a locked viewport.

     The page is its own query container: cq* units below resolve against the
     viewport width, since no stage wraps a work page any more. */
  .site {
    container-type: inline-size;
    display: grid;
    align-items: stretch;
    min-height: 100svh;
    /* Top pad clears the pinned chrome band (← Index); sides/foot are the frame
       inset. This is the shared chrome-band opt-in — no page content under chrome. */
    padding: var(--chrome-band) clamp(1rem, 3.2cqw, 3.5rem) clamp(1rem, 3.2cqw, 3.5rem);
    background-color: var(--paper);
    color: var(--ink);
  }

  /* The drawn page border: an outer rule plus an inset companion rule (::after),
     the printed page's oldest frame. A flex column so the footnotes hang at the
     foot when the text is short, and flow with it when the page runs tall. */
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line, var(--ink-2));
    padding: clamp(1.6rem, 3cqw, 3.2rem);
  }
  .page::after {
    content: '';
    position: absolute;
    inset: clamp(6px, 0.8cqw, 12px);
    border: 1px solid var(--line, var(--ink-2));
    pointer-events: none;
  }

  /* Reading-progress rule: a slim mark on the inner margin that fills with scroll.
     Exists only where it can animate (scroll-driven timeline + motion allowed) —
     elsewhere it is simply absent, never a broken static bar. */
  .reader__progress {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .reader__progress {
        display: block;
        position: absolute;
        left: clamp(6px, 0.8cqw, 12px);
        top: clamp(6px, 0.8cqw, 12px);
        bottom: clamp(6px, 0.8cqw, 12px);
        width: 2px;
        background-color: var(--spot, var(--ink));
        opacity: 0.5;
        transform-origin: top;
        scale: 1 0;
        animation: read-progress linear both;
        animation-timeline: scroll(root);
      }
      @keyframes read-progress {
        to {
          scale: 1 1;
        }
      }
    }
  }

  .reader {
    display: contents;
  }

  /* Masthead: a mono folio line (real metadata) above a single display title,
     hung on the column's own left edge. */
  .reader__head {
    width: min(64ch, 100%);
    margin-inline: auto;
  }
  .reader__folio {
    margin: 0;
    font-size: var(--type-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-1, var(--ink));
  }
  .reader__title {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-weight: var(--wght-display, 700);
    font-size: clamp(1.6rem, 4cqw, 3.4rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-display, -0.02em);
    text-wrap: balance;
  }

  /* The single measure: the whole design decision. ~62ch, centred, ragged-right
     (set type reads better on an even left edge than a justified river), with
     hyphenation on so the ragged edge stays gentle. */
  .reader__col {
    width: min(62ch, 100%);
    margin: var(--space-5) auto 0;
    font-size: clamp(1rem, 1.35cqw, 1.4rem);
    line-height: 1.55;
    text-align: left;
    text-wrap: pretty;
    hyphens: auto;
  }
  .reader__col p {
    margin: 0;
    text-indent: 1.6em;
  }
  .reader__col p:first-child {
    text-indent: 0; /* opening paragraph sets flush, as set text does */
  }
  .reader__col sup a {
    color: var(--ink);
    text-decoration: none;
    font-feature-settings: 'sups';
  }
  .reader__col sup a:hover,
  .reader__col sup a:focus-visible {
    color: var(--spot, var(--ink));
  }

  /* The specimen. A real plate sized to the measure, sitting on a paper-tint
     skeleton so nothing jumps before the bytes arrive; the image fades in over
     the skeleton on first render (no JS — @starting-style entry). A click makes
     it a lens; the cursor is the only invitation. */
  .plate {
    position: relative;
    width: min(22ch, 60%);
    margin: var(--space-4) auto;
  }
  .plate__btn {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    padding: 0;
    background-color: var(--paper-1, var(--paper));
    border: 1px solid var(--line, var(--ink-2));
    cursor: zoom-in;
    transition: scale var(--dur, 0.3s) var(--ease, ease);
    transform-origin: center;
    z-index: 0;
  }
  .plate__btn:focus-visible {
    outline: 2px solid var(--spot, var(--ink));
    outline-offset: 3px;
  }
  .plate__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  @starting-style {
    .plate__img {
      opacity: 0;
    }
  }
  .plate[data-lens] .plate__btn {
    scale: 1.4;
    cursor: zoom-out;
    z-index: 3;
    box-shadow: var(--shadow, 0 1cqw 3cqw rgb(0 0 0 / 0.18));
  }
  .plate__cap {
    margin-top: var(--space-1);
    text-align: center;
    font-size: var(--type-label);
    letter-spacing: 0.06em;
    color: var(--ink-1, var(--ink));
  }

  /* Footnotes: a step down, hung on a short rule at the foot of the frame. flex
     margin-top:auto floats them to the foot when the text is short. */
  .reader__notes {
    width: min(62ch, 100%);
    margin: auto auto 0;
    padding-top: var(--space-3);
  }
  .reader__notes::before {
    content: '';
    display: block;
    width: 8ch;
    border-top: 1px solid var(--line, var(--ink-2));
    margin-bottom: var(--space-2);
  }
  .reader__fn {
    margin: 0;
    padding-left: 1.6em;
    font-size: clamp(0.78rem, 1cqw, 1rem);
    line-height: 1.35;
    color: var(--ink-1, var(--ink));
  }
  .reader__fn li + li {
    margin-top: 0.4em;
  }
  .reader__fn a {
    color: var(--ink-1, var(--ink));
    text-decoration: none;
  }
  .reader__fn a:hover,
  .reader__fn a:focus-visible {
    color: var(--spot, var(--ink));
  }

  /* Motion is a nicety, not the mechanic — reduced-motion keeps the lens instant. */
  @media (prefers-reduced-motion: reduce) {
    .plate__btn,
    .plate__img {
      transition: none;
    }
  }

  /* Phone: the source page adapting, not a second design. A reading column is
     already single-measure, so it just narrows to the device; the frame's inset
     tightens and the plate stays clear of the viewport edge even when magnified. */
  @container (max-width: 40rem) {
    .reader__col,
    .reader__head,
    .reader__notes {
      width: 100%;
    }
    .plate {
      width: min(22ch, 62%);
    }
  }
</style>
