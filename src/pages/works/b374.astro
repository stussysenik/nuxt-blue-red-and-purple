---
// B374 — bespoke in-kernel reconstruction.
//
// The page IS the recreation: an open book spread that fills the viewport. Each
// spread is a full-height row split at the gutter — a verso (left) against a
// near-empty recto (right) — and the spreads stack in natural document scroll:
// no inner scroller, no locked viewport, the page grows and the window scrolls.
// One verso carries the plate — the committed photograph, full-bleed, the book's
// single artwork — the others carry a large folio number. Each recto hangs one
// portrait specimen plate flush to the gutter and is otherwise paper. A mono
// running head holds the top margin, below the chrome band.
//
// The fold is the whole trick: a crease pinned at the viewport centre (fixed,
// not scrolled) sinks the two columns into a verso/recto spine. The mechanic is
// live, not pictured — as the reader scrolls between spreads the fold shade
// deepens then relaxes, so a turn reads as a page lifting, and a slim spine
// progress fills down the crease (CSS scroll-driven). Both degrade safely: no JS
// leaves a static crease, reduced-motion leaves it still. Plates are de-branded
// kernel specimens — we rebuild the room, not the client's artwork. All
// spacing/type composes from kernel custom properties.
//
// Reference (internal, never shipped): refs/works/b374.jpg, 1600×1000. The recto
// plate keeps the source's proportions (portrait, hung high off the gutter); the
// rest is re-composed for continuous scroll rather than transcribed pixel for
// pixel, since the page is no longer a single locked frame.
//
// This reference's source nav is top-RIGHT — the one place it would collide with
// the sitewide pinned ← Index (design.md: source navs are top-left in nearly
// every reference). The band opt-in resolves it honestly: the running head is one
// left-anchored mono line living in the chrome band, so the top-right corner
// stays the ← Index's alone — no corner hack, no override of the shared chrome.
//
// Archived case-study copy (removed from DOM 2026-07-17):
//
//   The signature —
//   The screen is set as an open book. The left page carries a full-bleed plate
//   edge to edge; the right page stays white except for one portrait plate
//   tucked high against the gutter; the wordmark and index links hold the top
//   margin like running heads. The fold is the whole trick — pinned strips of
//   shadow sinking into a thin centre highlight make two ordinary columns read
//   as verso and recto, so scrolling stops feeling like a webpage and starts
//   feeling like turning spreads.
//
//   Study notes —
//   The asymmetry is doing the composing: a dense verso against a recto that is
//   four-fifths empty, with the single plate hung from the gutter rather than
//   centred in its page. Because the crease is pinned, every spread inherits the
//   same spine — margins, plate offsets, and running heads never move while
//   content changes underneath, which is exactly what lets the eye accept the
//   fold as physical. The white of the right page reads as paper, not absence,
//   and that is why this study rebuilds the spacing instead of screenshotting it.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('works', 'b374');
const w = entry!.data;
const SPREADS = 4;
---

<Base title={`${w.title} — *blue red + purple/`} chrome="work">
  <main class="site">
    <header class="site__nav font-mono">
      <span class="site__wordmark">{w.title} Press</span>
      <span class="site__sep" aria-hidden="true">·</span>
      <span class="site__links">Information, Index</span>
    </header>

    {
      Array.from({ length: SPREADS }, (_, i) => (
        <section class="spread" aria-label={`Spread ${i + 1} of ${SPREADS}`}>
          <figure class="page page--verso">
            {i === 0 ? (
              <img
                class="art"
                src={w.image}
                alt={`${w.title} plate`}
                width="1600"
                height="1000"
                decoding="async"
              />
            ) : (
              <span class="page__num font-mono">{String(i + 1).padStart(2, '0')}</span>
            )}
          </figure>
          <figure class="page page--recto">
            <span class="plate">
              <span class="plate__num font-mono">{String(i + 1).padStart(2, '0')}</span>
            </span>
          </figure>
        </section>
      ))
    }

    <!-- The fold: pinned to the viewport centre, over the scrolling spreads. -->
    <div class="crease" aria-hidden="true">
      <span class="crease__progress"></span>
    </div>
  </main>
</Base>

<script>
  // Pinned-crease spreads: the fold shade deepens between spreads, like a page
  // lifting, then relaxes as the next spread settles flat. Reads real window
  // scroll (natural document scroll, no inner scroller); a sawtooth of the
  // per-viewport position drives --turn. Enhancement only — without JS the crease
  // holds at its base depth.
  const site = document.querySelector<HTMLElement>('.site');
  const onScroll = () => {
    const pos = window.scrollY / window.innerHeight;
    const turn = Math.min(1, Math.abs(pos - Math.round(pos)) * 2);
    site?.style.setProperty('--turn', turn.toFixed(3));
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  /* The rebuilt room, now the whole page and a continuous scroll: spreads stack
     in document flow, the window scrolls, nothing is clipped. The page is its own
     query container — no stage wraps a work page any more, so every cq* unit
     below resolves against the viewport width. */
  .site {
    container-type: inline-size;
    position: relative;
    min-height: 100svh;
    /* Top pad seats the running head in the chrome band, clear of the pinned
       ← Index. The shared band opt-in — no page content under chrome. */
    padding-top: var(--chrome-band);
    background-color: var(--paper);
    color: var(--ink);
  }

  /* Running head: one mono line in the top margin, left-anchored so the top-right
     corner stays the ← Index's. Sticky, so it runs over every spread as the book
     turns — exactly what a running head does on a printed page. */
  .site__nav {
    position: sticky;
    top: var(--chrome-band);
    z-index: 3;
    display: flex;
    align-items: baseline;
    gap: 0.6ch;
    padding: 0.4rem clamp(1rem, 3cqw, 3rem);
    font-size: clamp(0.7rem, 0.95cqw, 1.05rem);
    line-height: 1;
    letter-spacing: 0.01em;
    pointer-events: none;
  }
  .site__wordmark {
    font-weight: 600;
  }
  .site__sep,
  .site__links {
    color: var(--ink-1, var(--ink));
  }

  /* One spread: a full-height verso|recto split. scroll-snap is deliberately not
     used — natural reading scroll is the mandate, and the pinned crease, not a
     hard snap, is what makes the turn read. */
  .spread {
    min-height: calc(100svh - var(--chrome-band));
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .page {
    position: relative;
    margin: 0;
  }
  /* Verso: the artwork page. On the plate spread it is the committed photograph,
     full-bleed; elsewhere a large folio number. The paper-tint ground doubles as
     the image's load-in skeleton, so nothing flashes before the bytes arrive. */
  .page--verso {
    display: grid;
    place-items: center;
    background-color: var(--paper-1, var(--paper));
  }
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  @starting-style {
    .art {
      opacity: 0;
    }
  }
  .page__num {
    font-size: clamp(2.5rem, 10cqw, 10rem);
    color: var(--ink-3, var(--ink-2));
    letter-spacing: 0.04em;
  }
  /* One spread carries the spot colour — "artwork carries colour" (the plate
     spread already does, in the photograph). */
  .spread:nth-of-type(3) .page__num {
    color: var(--spot, var(--ink));
  }

  /* Recto: white page, one portrait plate hung high and flush to the gutter —
     the source's proportions (x800→1199, y34→609 of 1600×1000: half the recto
     wide, 400/576 in aspect, its left edge buried in the fold). */
  .plate {
    position: absolute;
    top: 3.4%;
    left: 0;
    display: grid;
    place-items: center;
    width: 50%;
    aspect-ratio: 400 / 576;
    background-color: var(--paper-1, var(--paper));
    border: 1px solid var(--line, var(--ink-2));
    box-shadow: var(--shadow, none);
  }
  .plate__num {
    font-size: clamp(0.9rem, 2.4cqw, 2.4rem);
    color: var(--ink-2);
    letter-spacing: 0.06em;
  }

  /* The fold, pinned to the viewport centre over the scrolling spreads. The
     reference's crease is a synthetic gradient, not photographed paper — its
     falloff is identical to two decimals on every row (alpha 0.87 at the fold,
     0.43 at 5px, 0.24 at 9px, 0.14 at 13px, 0.06 at 21px, gone by 32px ≈ 2cqw),
     far tighter than a linear ramp, hence the stops. --turn (from the script)
     deepens the whole crease as a spread lifts; without JS it holds at base. */
  .crease {
    position: fixed;
    top: var(--chrome-band);
    bottom: 0;
    left: 50%;
    width: 0;
    pointer-events: none;
    z-index: 2;
    opacity: calc(0.87 + var(--turn, 0) * 0.13);
  }
  .crease::before,
  .crease::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2cqw;
    background-image: linear-gradient(
      var(--crease-dir, 90deg),
      var(--ink) 0,
      color-mix(in srgb, var(--ink) 49%, transparent) 16%,
      color-mix(in srgb, var(--ink) 28%, transparent) 28%,
      color-mix(in srgb, var(--ink) 16%, transparent) 41%,
      color-mix(in srgb, var(--ink) 7%, transparent) 66%,
      transparent 100%
    );
  }
  .crease::before {
    right: 0;
    --crease-dir: 270deg;
  }
  .crease::after {
    left: 0;
  }

  /* Spine progress: a slim mark down the fold that fills with scroll — the one
     CSS scroll-driven behaviour, present only where it can animate (scroll
     timeline + motion allowed), never a broken static bar elsewhere. */
  .crease__progress {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .crease__progress {
        display: block;
        position: absolute;
        top: 0;
        left: -1px;
        width: 2px;
        height: 100%;
        background-color: var(--spot, var(--ink));
        opacity: 0.55;
        transform-origin: top;
        scale: 1 0;
        animation: spine-fill linear both;
        animation-timeline: scroll(root);
      }
      @keyframes spine-fill {
        to {
          scale: 1 1;
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art {
      transition: none;
    }
  }

  /* Phone: the source layout adapting, not a second design. The spread stays a
     spread — the fold is the whole point — but half of a narrow recto is not a
     plate, so it takes the width it needs, as the exemplar's does. */
  @container (max-width: 40rem) {
    .plate {
      width: 72%;
    }
  }
</style>
