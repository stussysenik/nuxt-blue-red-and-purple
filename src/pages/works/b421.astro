---
// B421 — bespoke in-kernel reconstruction.
//
// The page IS the recreation: a proposal deck wearing a website, edge-to-edge.
// Two rows of pinned chrome — wordmark, A/B/C switcher, right-set spec
// paragraph — sit on hairlines above a gallery grid whose plates each declare
// their own ratio in a caption rail (A1 — 1:1 … 2:1), with a three-part
// colophon on the bottom baseline. The page scrolls naturally — the two chrome
// baselines are a sticky cover sheet seated in the band, not a locked viewport,
// and the deck flows under them. The mechanic is live, not pictured: A/B/C
// hard-swaps the whole sheet — label, plate tally, grid — under chrome that
// never moves. Plates are de-branded kernel specimens; plate A1 seats the
// committed photograph as the deck's one artwork ("artwork carries colour"). The
// work's white/black grafts inline as
// --site-paper/--site-ink; its blue rides in as --work-accent ("artwork carries
// colour"). The room's hairline + muted tone derive from that grafted pair, not
// from mode-dependent kernel tokens, so the sheet stays stark in every mode.
//
// Reference (internal, never shipped): refs/works/b421.jpg, 1600×1000, L=255.
// Measured with scripts/ref-geometry.py, then converted x/1600*100 → cqw:
//
//   content box   ink x11→1587                 → padding-inline .75cqw (12px)
//   4 columns     dividers x406/800/1194       → 4×394px, no gap; borders divide
//   chrome type   band y12→26 (15px)           → clamp(.75rem, 1cqw, 1.05rem)
//   right column  x1068→1587 (519 of 1576)     → 1fr minmax(0, 32.9%)
//   row A         ink y12→26, rule y37         → padding .55em .75cqw .5em
//   row B         ink y51→134 (5 lines), y163  → padding .65em .75cqw 1.6em
//   spec copy     519px wide, pitch ~17.8px    → .82em / line-height 1.36
//   deck top      rule y163 → art y227 (64px)  → padding-top 4cqw
//   art box       291sq centred in a 394 col   → width 74%, margin-bottom 3.4cqw
//   caption rail  rule y573, ink y583→591 (9)  → clamp(.55rem, .78cqw, .85rem)
//   caption inset text x24 / x419 / x812       → padding-left .75cqw (12px)
//   row gap       row1 ends 605, row2 top 677  → margin-top 4.5cqw (72px)
//   footer        rule y962, ink y975→989      → padding .55em .75cqw
//
// The two gallery rows land on the same art height (291px) from opposite rules —
// 4 columns at 1:1 and 2 columns at 2:1 — which is the sheet's own logic, and
// the reference confirms it (subject bands 272px and 268px). The spec paragraph
// was extended to the reference's five-line block: the source's is lorem, ours
// is real, and the wrap point is a measured target like any other.
//
// Archived case-study copy (removed from DOM 2026-07-17):
//
//   The signature —
//   A client presentation formatted as a public page. The chrome reads like a
//   cover sheet — studio name, a live "Proposal: A. B. C." switcher, spec copy
//   set into the right third — and the gallery reads like deck pages: every
//   artwork sits over a caption cell declaring its index and ratio on a
//   hairline. Switching proposals replaces the entire sheet while the two chrome
//   baselines and the colophon hold perfectly still.
//
//   Study notes —
//   The chrome runs on thirds — copy column pinned at the right third — while
//   the gallery runs on quarters and halves, and the two systems never align;
//   the per-plate caption hairlines reconcile them, turning the grid into its
//   own legend. Because row height is derived from the declared ratio, a row of
//   four squares and a row of two 2:1 plates land on identical margins — the
//   swap between proposals reads as one sheet replacing another, not a layout
//   re-flowing.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('works', 'b421');
const w = entry!.data;
const [accent, sitePaper, siteInk] = w.palette ?? [];

// Three decks: A transcribed from the reference, B/C extended by its own rule —
// every row takes its height from the ratio its plates declare (… C8 4:1).
const SPECS: [string, { ratio: string; count: number }[]][] = [
  ['A', [{ ratio: '1:1', count: 4 }, { ratio: '2:1', count: 2 }]],
  ['B', [{ ratio: '3:2', count: 2 }, { ratio: '1:1', count: 3 }]],
  ['C', [{ ratio: '1:1', count: 4 }, { ratio: '4:3', count: 3 }, { ratio: '4:1', count: 1 }]],
];
const DECKS = SPECS.map(([id, specs]) => {
  let n = 0;
  const rows = specs.map((r) => ({ ...r, cells: Array.from({ length: r.count }, () => `${id}${++n}`) }));
  return { id, rows, plates: String(n).padStart(2, '0') };
});
---

<Base title={`${w.title} — *blue red + purple/`} chrome="work">
  <main
    class="site"
    style={`--site-paper:${sitePaper ?? 'var(--paper)'};--site-ink:${siteInk ?? 'var(--ink)'}${accent ? `;--work-accent:${accent}` : ''}`}
  >
    <header class="site__chrome">
      <div class="site__row">
        <span class="site__wordmark">{w.title} Studio, Inc.</span>
        <span class="site__meta">
          <span>Proposal:&ensp;{DECKS.map((d, i) => (
            <button class="sw" type="button" data-deck={d.id} data-on={i === 0 ? '' : undefined}>{d.id}.</button>
          ))}</span>
          <span class="site__tally font-mono">{DECKS[0]!.plates} plates</span>
        </span>
      </div>
      <div class="site__row">
        <span class="site__proposal">Proposal A</span>
        <p class="site__copy">
          Each proposal is a fixed sequence of plates. Every plate declares its ratio in the
          caption rail beneath it, and each row takes its height from that declaration — a row of
          four squares and a row of two 2:1 plates land on identical margins. Switching proposals
          replaces the whole sheet under the same two baselines: the label and the plate tally
          move, the chrome does not.
        </p>
      </div>
    </header>

    <div class="site__scroll">
      {DECKS.map((d, di) => (
          <section class="deck" data-deck={d.id} data-plates={d.plates} data-on={di === 0 ? '' : undefined}>
            {d.rows.map((r) => (
              <div class="row" style={`--cols:${r.count};--ar:${r.ratio.replace(':', ' / ')}`}>
                {r.cells.map((label) => (
                  <figure class="cell">
                    <span class="cell__art">
                      {label === 'A1' ? (
                        <img
                          class="cell__img"
                          src={w.image}
                          alt={`${w.title} plate`}
                          width="1600"
                          height="1000"
                          decoding="async"
                        />
                      ) : (
                        <span class="cell__num font-mono">{label}</span>
                      )}
                    </span>
                    <figcaption class="cell__tag font-mono">{label} — {r.ratio}</figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </section>
        ))}
    </div>

    <footer class="site__foot">
      <span class="site__mail" aria-hidden="true">Email</span>
      <span class="site__meta">
        <span>{w.title} — proposal deck</span>
        <span class="font-mono">№ 0421</span>
      </span>
    </footer>
  </main>
</Base>

<script>
  // A/B/C switcher: the whole deck hard-swaps under pinned chrome; proposal
  // label + plate tally move in lockstep, scroll resets to the top edge.
  const site = document.querySelector<HTMLElement>('.site');
  const decks = Array.from(site?.querySelectorAll<HTMLElement>('.deck') ?? []);
  const btns = Array.from(site?.querySelectorAll<HTMLButtonElement>('.sw') ?? []);
  const label = site?.querySelector<HTMLElement>('.site__proposal');
  const tally = site?.querySelector<HTMLElement>('.site__tally');
  const scroll = site?.querySelector<HTMLElement>('.site__scroll');
  const pick = (id: string) => {
    for (const d of decks) d.toggleAttribute('data-on', d.dataset.deck === id);
    for (const b of btns) b.toggleAttribute('data-on', b.dataset.deck === id);
    if (label) label.textContent = `Proposal ${id}`;
    const on = decks.find((d) => d.dataset.deck === id);
    if (tally && on) tally.textContent = `${on.dataset.plates} plates`;
    // Natural document scroll now — reset to the top so the new deck reads from
    // its first plate, under the sticky chrome that never leaves the band.
    if (scroll) window.scrollTo({ top: 0 });
  };
  for (const b of btns) b.addEventListener('click', () => pick(b.dataset.deck ?? 'A'));
</script>

<style>
  /* The rebuilt room, now the whole page and a continuous scroll: the two chrome
     baselines pin as a sticky cover sheet, the deck flows and the window scrolls
     between them and the colophon — no inner scroller, no locked viewport. The
     page is its own query container — the stage used to provide one, so cq* units
     silently resolve against the viewport without this. */
  .site {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    /* Top pad seats the sticky chrome in the band, clear of the pinned ← Index —
       the shared band opt-in, so no page content sits under chrome. */
    padding-top: var(--chrome-band);
    background-color: var(--site-paper, var(--paper));
    color: var(--site-ink, var(--ink));
    /* Reference chrome band y12→26 = 15px ink at 1600 → ~16px type. */
    font-size: clamp(0.75rem, 1cqw, 1.05rem);
    line-height: 1.2;
    /* The room's own tones, derived from the grafted pair rather than kernel
       --line/--ink-2, which follow the active mode and would break the graft. */
    --site-line: color-mix(in oklab, var(--site-ink, var(--ink)) 20%, var(--site-paper, var(--paper)));
    --site-ink-2: color-mix(in oklab, var(--site-ink, var(--ink)) 55%, var(--site-paper, var(--paper)));
  }

  /* The cover sheet stays put: sticky at the band while the deck scrolls under
     it. Its own paper backs it so plates never bleed through as they pass. */
  .site__chrome {
    position: sticky;
    top: var(--chrome-band);
    z-index: 4;
    background-color: var(--site-paper, var(--paper));
  }

  /* Chrome and colophon share one grid on thirds: the right column runs
     x1068→1587 in the reference — 519 of the 1576px content box. The gallery
     below runs on quarters; the mismatch is the source's, kept deliberately. */
  .site__row,
  .site__foot {
    display: grid;
    grid-template-columns: 1fr minmax(0, 32.9%);
    gap: 0.5em 2em;
  }
  .site__row {
    border-bottom: 1px solid var(--site-line);
  }
  /* Row A: ink y12→26 under a rule at y37. */
  .site__row:first-child {
    padding: 0.55em 0.75cqw 0.5em;
  }
  /* Row B: the five-line spec block, ink y51→134 under a rule at y163. */
  .site__row + .site__row {
    padding: 0.65em 0.75cqw 1.6em;
  }
  .site__meta {
    display: flex;
    justify-content: space-between;
    gap: 1em;
  }
  .sw {
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    margin-right: 0.45em;
    color: var(--work-accent, var(--spot));
    text-decoration: underline;
    cursor: pointer;
  }
  .sw[data-on] {
    color: inherit;
    text-decoration: none;
  }
  .site__copy {
    margin: 0;
    /* 519px measure, five lines, ink pitch ~17.8px in the reference. */
    font-size: 0.82em;
    line-height: 1.36;
  }

  /* The gallery flows in the document now; flex:1 only floats the colophon to
     the foot when a deck is short. No inner scroller, no clipping. */
  .site__scroll {
    flex: 1;
    min-height: 0;
  }
  /* Rule y163 → first art box y227 = 64px = 4cqw. */
  .deck {
    display: none;
    padding: 4cqw 0.75cqw 5cqw;
  }
  .deck[data-on] {
    display: block;
  }
  /* Columns are contiguous — the reference divides them with rules at
     x406/800/1194, not with a gap. */
  .row {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
  }
  .row + .row {
    margin-top: 4.5cqw;
  }

  /* Specimen plates: the ratio each caption declares IS the panel's geometry.
     74% of a 394px column = the reference's 291px art block; the same 74% of a
     788px column at 2:1 lands on the same 291px height, which is the sheet's
     own rule and why the reference's two rows share a baseline. */
  .cell {
    margin: 0;
  }
  .cell__art {
    position: relative;
    display: grid;
    place-items: center;
    width: 74%;
    margin: 0 auto 3.4cqw;
    aspect-ratio: var(--ar, 1);
    border: 1px solid var(--site-line);
    /* Paper-tint ground = the load-in skeleton behind the plate photograph. */
    background-color: color-mix(in oklab, var(--site-paper, var(--paper)) 92%, var(--site-ink, var(--ink)));
  }
  .cell__num {
    font-size: clamp(0.9rem, 3.4cqw, 2.2rem);
    color: var(--site-ink-2);
  }
  /* Plate A1 is the committed photograph — the deck's one artwork. Fills its
     declared-ratio box, fading in over the skeleton on first render (no JS). */
  .cell__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  @starting-style {
    .cell__img {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cell__img {
      transition: none;
    }
  }
  /* Every third plate carries the work's blue — "artwork carries colour". */
  .cell:nth-child(3n + 1) .cell__num {
    color: var(--work-accent, var(--spot));
  }
  .site__tally,
  .cell__tag {
    letter-spacing: 0.06em;
  }
  /* Caption rail: rule at y573, ink y583→591 (capH 9), text inset 12px from the
     column's own edge; the divider between cells is the rail's left border. */
  .cell__tag {
    border-top: 1px solid var(--site-line);
    padding: 0.55em 0.75em 0.55em 0.75cqw;
    font-size: clamp(0.55rem, 0.78cqw, 0.85rem);
  }
  .cell + .cell .cell__tag {
    border-left: 1px solid var(--site-line);
  }

  /* Colophon: rule y962, ink y975→989 — the middle item hangs off the same
     right column as the chrome above it, not off the page centre. */
  .site__foot {
    padding: 0.55em 0.75cqw;
    border-top: 1px solid var(--site-line);
  }
  .site__mail {
    color: var(--work-accent, var(--spot));
    text-decoration: underline;
  }

  /* Phone: the source sheet adapting, not a second design. The thirds collapse
     to one column and the gallery degrades to one plate per row, so every plate
     still declares its ratio at a legible size. */
  @container (max-width: 40rem) {
    .site__row,
    .site__foot {
      grid-template-columns: 1fr;
    }
    .row {
      grid-template-columns: 1fr;
    }
    .cell + .cell {
      margin-top: 4.5cqw;
    }
    .cell + .cell .cell__tag {
      border-left: none;
    }
  }
</style>
