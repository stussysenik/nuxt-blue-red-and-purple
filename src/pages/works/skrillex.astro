---
// Skrillex — bespoke in-kernel reconstruction.
//
// The page IS the recreation: the reference's signature layout fills the
// viewport edge-to-edge, exactly as the source frames itself. There is no
// layout to speak of — the artwork bleeds to all four edges and every
// character lives in one vertical rail hugging the left edge, reading
// bottom-to-top: wordmark, a three-stroke glyph, then five nav words
// ascending. One typeface, one weight, one size, zero palette; the chrome is
// achromatic and the artwork carries all the colour. The mechanic is live,
// not pictured — the rail's lines arrive one per beat (click the room to
// replay). The artwork is a de-branded kernel specimen: a full-bleed field
// standing in for the photograph — we rebuild the room, not the client's
// artwork. This work ships no palette in its data, so the field composes from
// kernel --spot / --spot-2 only.
//
// Reference (internal, never shipped): refs/works/skrillex.jpg, 3200×2000.
// ref-geometry degenerates here (design.md §Known tool limits): the rail is
// light type over a dark photo and a *local* ground under a photo is not
// modelled, so it collapses the rail into one 1712px "row". Every number below
// was read off the jpg against the rail's own backdrop instead.
//
// Archived case-study copy (removed from DOM 2026-07-17):
//
//   The signature —
//   There is no layout to speak of — that is the layout. The photograph runs
//   edge to edge, and the whole interface is one vertical line of mono type
//   climbing the left margin: wordmark, glyph, five nav words, all the same
//   size and the same weight. No palette is declared anywhere in the chrome;
//   the image supplies every ounce of colour, and the type stays as neutral as
//   a caption on a contact sheet.
//
//   Study notes —
//   Collapsing the type system to a single voice is what lets the page get away
//   with a full-bleed image: with one typeface at one weight there is no
//   hierarchy to defend, so the rail can sit on the artwork at any brightness
//   and still read as chrome, not content. The vertical setting buys the same
//   economy in space — seven items spend one text line of width and leave the
//   other ninety-odd percent of the canvas untouched.
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entry = await getEntry('works', 'skrillex');
const w = entry!.data;
// DOM order = bottom-to-top once the rail is rotated, matching the reference.
const RAIL = ['Contact', 'Signup', 'Merch', 'Tour', 'Music'];
---

<Base title={`${w.title} — *blue red + purple/`} chrome="work">
  <main class="site">
    <img
      class="art"
      src={w.image}
      alt={`${w.title} artwork`}
      width="1600"
      height="1000"
      decoding="async"
    />
    <div class="scrim" aria-hidden="true"></div>

    <!-- Lines ship arrived (data-on) so the rail survives without JS; the
         script strips and replays them on load. -->
    <nav class="rail font-mono ttu" aria-label="Rebuilt rail navigation">
      <span data-on>{w.title}</span>
      <span class="rail__glyph" data-on aria-hidden="true">≡</span>
      {RAIL.map((item) => <span data-on>{item}</span>)}
    </nav>

    <button class="replay" type="button" aria-label="Replay line-by-line arrival"></button>
  </main>
</Base>

<script>
  // Line-by-line arrival: the rail lands one line per beat; click replays.
  const site = document.querySelector<HTMLElement>('.site');
  const lines = Array.from(site?.querySelectorAll<HTMLElement>('.rail > *') ?? []);
  let t = 0;
  const run = () => {
    clearTimeout(t);
    for (const line of lines) line.removeAttribute('data-on');
    const step = (n: number) => {
      lines[n]?.setAttribute('data-on', '');
      if (n + 1 < lines.length) t = window.setTimeout(() => step(n + 1), 200);
    };
    t = window.setTimeout(() => step(0), 300);
  };
  site?.querySelector('.replay')?.addEventListener('click', run);
  run();
</script>

<style>
  /* The rebuilt room, now the whole page: the artwork bleeds to all four edges
     and the rail is the only other object. The page is its own query container
     — the stage used to provide one, so every cq* unit below would silently
     re-resolve against the viewport without this. */
  .site {
    container-type: inline-size;
    position: relative;
    min-height: 100svh;
    /* This room's ground is the artwork, not the paper, and the reference's
       ground is dark (L=45). So the room inverts the kernel duotone: the field
       is ink-weight and every mark on it is paper. The ink ground also serves as
       the image's load-in skeleton — the photo fades in over it. Without this the
       promoted page would ground itself in --paper (white in the light theme)
       and the rail would invert against the reference. */
    background-color: var(--ink);
    color: var(--paper);
  }

  /* The lone chrome mark inverts with the room, or it lands ink-on-ink. */
  :global(.chrome-back) {
    color: var(--paper);
  }

  /* The artwork, now the committed photograph itself: full-bleed, covering every
     edge — the room's only colour source, exactly as the concept intended when it
     stood a gradient field in for the photo. Fades in over the ink ground on first
     render (no JS — @starting-style), so there is no white flash before the bytes. */
  .art {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity 0.6s var(--ease, ease);
  }
  @starting-style {
    .art {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .art {
      transition: none;
    }
  }

  /* A soft ink scrim at the top-left, under the rail only: the reference's rail
     sat on a darker fall of the photo, so this keeps the paper rail legible over
     any brightness of the committed image without tinting the rest of the field.
     Ink-based, so it stays inside the duotone (colour law). */
  .scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: linear-gradient(
      115deg,
      color-mix(in oklab, var(--ink) 62%, transparent),
      transparent 55%
    );
  }

  /* One rail, one typeface, one weight, one size — the entire type system. Set
     vertical and rotated so it reads bottom-to-top as in the source; DOM-first
     (the wordmark) lands at the bottom. The box is content-height in the
     top-left corner, NOT full-height: the reference's rail runs y3→1142 of
     2000 and stops, so that length is content, not an anchor.

     Transcribed from the reference at 3200×2000, all seven lines identical:
     cap height 26px (0.81cqw) → 1.16cqw at IBM Plex Mono's 0.698 cap ratio;
     letter advance 24.3px → 0.6em + 0.05em tracking; ink-to-ink line gap 45px
     → 1.05em once the font's own side bearings (4.4px) and the tracking trail
     (1.9px) are taken back out. Top edge: the box at top:0 lands MUSIC's cap
     at y≈4 (reference y=3). */
  .rail {
    position: absolute;
    /* The art bleeds full to every edge; only the rail (text) opts into the
       chrome band, so its head clears the pinned ← Index instead of climbing into
       the reserved strip. The shared band opt-in for a full-bleed page. */
    inset: var(--chrome-band) auto auto 0;
    writing-mode: vertical-rl;
    rotate: 180deg;
    display: flex;
    gap: 1.05em;
    font-size: clamp(0.75rem, 1.16cqw, 1.9rem);
    font-weight: 500;
    letter-spacing: 0.05em;
    z-index: 1;
  }
  /* A single mark, not a word — tracking would only push it off its box. */
  .rail__glyph {
    letter-spacing: 0;
  }

  /* Arrival: each line fades in and settles along the reading direction.
     Hidden until the script grants data-on, one beat apart. */
  .rail > * {
    opacity: 0;
    translate: 0 -0.6em;
    transition:
      opacity var(--dur, 0.25s) var(--ease, ease),
      translate var(--dur, 0.25s) var(--ease, ease);
  }
  .rail > [data-on] {
    opacity: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .rail > * {
      transition: none;
    }
  }

  /* The replay surface: the whole room, zero chrome. */
  .replay {
    position: absolute;
    inset: 0;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    z-index: 2;
  }
  .replay:focus-visible {
    outline: var(--border-w, 2px) solid var(--paper);
    outline-offset: -6px;
  }
</style>
