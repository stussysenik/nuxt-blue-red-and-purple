---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
// Wordmark is the vendored brand SVG; inlined so its fill follows the kernel
// --ink token and re-skins with the active mode. The pinned chrome (home mark,
// menu-is-index island, theme toggle) now lives globally in Base.astro.
import wordmark from '../../public/done.svg?raw';

// The Project Index — rendered inline in §01 as a collapsible disclosure. Same
// deterministic sort as Base's menu payload (live client first, then newest,
// then alphabetical) so the (N#) numbering is stable across every surface.
const works = (await getCollection('works'))
  .map((entry) => entry.data)
  .filter((w) => !w.hidden)
  .toSorted(
    (a, b) =>
      Number(b.real ?? false) - Number(a.real ?? false) ||
      b.year - a.year ||
      a.title.localeCompare(b.title),
  );
---

<Base>
  <!-- ── Generative-mode background: preserved shader scenes graded to the
       kernel's ink/paper duotone. Fixed layer behind the chrome, shown only in
       generative mode; the loop suspends elsewhere (src/gl/background.ts). A
       paper veil keeps chrome legible over the scenes. ── -->
  <div class="gen-bg" aria-hidden="true">
    <canvas id="gen-canvas"></canvas>
  </div>

  <!-- ── Construction grid (pinned decor; pinned elements may overlap it) ── -->
  <div class="grid-rig" aria-hidden="true">
    <span class="grid-rig__v grid-rig__v--1"></span>
    <span class="grid-rig__v grid-rig__v--2"></span>
    <span class="grid-rig__v grid-rig__v--3"></span>
    <span class="grid-rig__h grid-rig__h--1"></span>
    <span class="grid-rig__h grid-rig__h--2"></span>
  </div>

  <!-- ── §00 Hero ── -->
  <section id="hero" class="hero" data-section="00">
    <h1 class="wordmark" set:html={wordmark} aria-label="blue red + purple" />
    <!-- The mode wheel is archived, not deleted: the site now ships generative
         as the sole default. The four-mode selector (`page = mode(content)`) is
         preserved as a concept — the component lives in
         `src/components/mode-wheel.ts`, the four kernels in `src/styles/modes/`,
         and all four render live at /design. To restore the live switcher, import
         ModeWheel again and drop `<ModeWheel client:load />` back in here. -->
    <p class="tagline font-mono ttu tracked">
      Too much blue will never amount to any red
    </p>
  </section>

  <!-- ── §01 Works — the entry to the Project Index. The index itself is a
       standalone white-label page (src/pages/works/index.astro): a full-screen,
       centered, scrollable list driven by the works collection. This CTA simply
       routes there, so there is one source of the concept, not a duplicate. ── -->
  <!-- <section id="works" class="band" data-section="01">
    <p class="band__index font-mono">(01)</p>
    <h2 class="band__title">Works</h2>
    <p class="band__lead measure-wide lh-copy">
      Seventeen studies across five verticals — restaurants, hotels, music
      venues, vintage, book stores — and one live client service. Each rebuilt
      in our own kernel, never remixed.
    </p>

    <a class="index-trigger font-mono ttu tracked" href="/works">
      <span class="dot" aria-hidden="true"></span>
      <span>Project index</span>
      <span class="index-trigger__count">({works.length})</span>
    </a>
  </section> -->

  <!-- ── §02 Philosophy ── -->
  <!-- <section id="philosophy" class="band" data-section="02">
    <p class="band__index font-mono">(02)</p>
    <h2 class="band__title">Philosophy</h2>
    <p class="band__lead measure-wide lh-copy">
      One fixed content structure, four interchangeable design systems. The
      wheel is the parent function:
      <code class="font-mono">page = mode(content)</code>. Consistency is
      enforced at build — off-system CSS cannot compile.
    </p>
  </section> -->

  <!-- ── §03 Approach ── -->
  <!-- <section id="approach" class="band" data-section="03">
    <p class="band__index font-mono">(03)</p>
    <h2 class="band__title">Approach</h2>
    <p class="band__lead measure-wide lh-copy">
      We build one-page systems. Type scale, color pairs, line weight, motion
      character — a complete token kernel per mode, four of them living on one
      DOM. Any brand can see itself in the chrome; the works carry the color.
    </p>
  </section> -->

  <!-- ── §04 About ── -->
  <section id="about" class="band" data-section="04">
    <p class="band__index font-mono">(04)</p>
    <h2 class="band__title">About us</h2>
    <p class="band__lead measure-wide lh-copy">
     We are a multi-disciplinary design communication studio that connects the unconnected by creating coherent and intuitive design. Every great idea begins with something fragile. Whether an idea is just at the beginning, taking shape, or ready to scale, we partner with our clients to build thoughtful work that feel intuitive, memorable and true to your vision. <br>
    </p>
    <p class="band__lead measure-wide lh-copy">
      <br> Our Formula:<br> –1 → 0 <br> Discovering possibilities through curiosity, research, and brainstorming. <br> 0 → 1 <br> Bringing ideas to life through thoughtful design and technology. <br>1+<br> Helping brands grow through continued creativity, refinement, and evolution.
    </p>
  </section>

  <!-- ── §05 Ledger (the checkable claim) ── -->
  <!-- <section id="ledger" class="band" data-section="05">
    <p class="band__index font-mono">(05)</p>
    <h2 class="band__title">Ledger</h2>
    <dl class="ledger font-mono">
      <div class="ledger__row"><dt>Live client service</dt><dd>1</dd></div>
      <div class="ledger__row"><dt>Researched works</dt><dd>17</dd></div>
      <div class="ledger__row"><dt>Design systems on one DOM</dt><dd>4</dd></div>
      <div class="ledger__row"><dt>Assured visual states</dt><dd>24</dd></div>
    </dl>
  </section> -->

  <!-- ── §06 Contacts ── -->
  <section id="contacts" class="band band--last" data-section="06">
    <p class="band__index font-mono">(06)</p>
    <h2 class="band__title">Contacts</h2>
    <p class="band__lead measure lh-copy">
      <a href="mailto:hi@blueredandpurple.world" class="contact-link">
        hi@blueredandpurple.world
      </a>
    </p>
  </section>

</Base>

<script>
  // Generative-mode shader background. Loads on every page but stays inert
  // (no WebGL context) until the wheel first selects generative mode.
  import { mountGenerativeBackground } from '../gl/background';

  const canvas = document.getElementById('gen-canvas');
  if (canvas instanceof HTMLCanvasElement) mountGenerativeBackground(canvas);

  // The Project Index is a routed page (/works) now — the §01 CTA is a plain
  // link, so no controller lives here.
</script>

<style>
  /* Structural styles compose only from kernel custom properties — the same
     escape hatch the Lit islands use. No rogue hex, no arbitrary utilities. */

  /* Generative-mode background layer — behind content (z 1), above the body
     paper. Hidden outside generative mode; the runner suspends its loop in
     lockstep, so it costs nothing when unseen. */
  .gen-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity var(--dur) var(--ease),
      visibility var(--dur) var(--ease);
  }
  :global(:root[data-mode='generative']) .gen-bg {
    opacity: 1;
    visibility: visible;
  }
  #gen-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Legibility veil: softens the scenes toward paper so --ink chrome stays
     readable over the moving background without hiding it. */
  .gen-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--paper);
    opacity: 0.28;
  }

  /* Hairline construction grid — the engineering register from the comp. */
  .grid-rig {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .grid-rig__v,
  .grid-rig__h {
    position: absolute;
    background-color: var(--line);
    opacity: 0.6;
  }
  .grid-rig__v {
    top: 0;
    bottom: 0;
    width: 1px;
  }
  .grid-rig__v--1 {
    left: var(--rig-v-1);
  }
  .grid-rig__v--2 {
    left: var(--rig-v-2);
  }
  .grid-rig__v--3 {
    left: var(--rig-v-3);
  }
  .grid-rig__h {
    left: 0;
    right: 0;
    height: 1px;
  }
  .grid-rig__h--1 {
    top: var(--rig-h-1);
  }
  .grid-rig__h--2 {
    top: var(--rig-h-2);
  }

  /* Dot language — filled = active/hovered, outline = idle. */
  .dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 100%;
    border: 1px solid currentColor;
    background-color: transparent;
    flex: none;
    transition:
      background-color 0.25s ease,
      transform 0.25s ease;
  }
  .dot[data-on='true'] {
    background-color: currentColor;
  }

  /* Hero. */
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100svh;
    display: grid;
    align-content: center;
    gap: 1.6rem;
    padding: 6rem var(--edge) 4rem;
  }
  .wordmark {
    display: block;
    width: min(78vw, 60rem);
    margin: 0;
  }
  .wordmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    fill: var(--ink);
  }
  .tagline {
    color: var(--ink);
    font-size: var(--type-label);
  }

  /* Content bands. */
  .band {
    position: relative;
    z-index: 1;
    padding: clamp(3rem, 12vh, 9rem) var(--edge);
    border-top: 1px solid var(--line);
  }
  .band--last {
    min-height: 60svh;
  }
  .band__index {
    font-size: var(--type-label);
    color: var(--ink-2);
    letter-spacing: 0.1em;
  }
  .band__title {
    font-family: var(--font-display);
    font-weight: var(--wght-display);
    line-height: 1;
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
    font-size: var(--type-display);
    margin: 0.4rem 0 1.4rem;
    color: var(--ink);
  }
  .band__lead {
    font-size: var(--type-body);
    line-height: 1.55;
    color: var(--ink-1);
  }
  .band__lead code {
    background-color: var(--paper-1);
    padding: 0.1em 0.35em;
    border-radius: 0.2rem;
  }
  /* ── Project Index trigger (§01) ──────────────────────────────────────────
     Routes to the /works index page. Wears the active kernel (essential = thin
     outline, brutal = heavy border + hard offset shadow, clay = rounded depth). */
  .index-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
    padding: 0.7rem 1.1rem;
    color: var(--ink);
    background-color: var(--surface);
    border: var(--border-w) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    cursor: pointer;
    font-size: 0.8rem;
    transition:
      color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .index-trigger:hover,
  .index-trigger:focus-visible {
    /* Canonical Riso Green — mode-independent, and legible on both the light
       (#f7f3ec) and dark (#16130f) papers (same green clay uses in both themes). */
    color: #00a95c;
  }
  .index-trigger:hover .dot,
  .index-trigger:focus-visible .dot {
    background-color: currentColor;
  }
  .index-trigger__count {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.8rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: var(--wght-display);
    font-size: clamp(1.4rem, 5vw, 3rem);
    text-transform: none;
  }
  .contact-link:hover {
    /* Canonical Riso Green — mode-independent, legible on both papers (the same
       green the Project Index trigger uses). --spot resolves to --ink in
       generative mode, so this is the deliberate hover accent. */
    color: #00a95c;
  }

  /* Ledger. */
  .ledger {
    display: grid;
    gap: 0.9rem;
    max-width: 34rem;
  }
  .ledger__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--line);
    color: var(--ink-1);
  }
  .ledger__row dd {
    font-family: var(--font-display);
    font-weight: var(--wght-display);
    font-size: 2rem;
    color: var(--ink);
  }
</style>
